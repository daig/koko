# Hermetic DML fixtures (P2-A): SET / DELETE / DETACH DELETE + write composition.
-DATASET CSV empty

--

-CASE Dml

-STATEMENT CREATE NODE TABLE P(id INT64, name STRING, age INT64, score DOUBLE, PRIMARY KEY(id));
---- ok
-STATEMENT CREATE REL TABLE K(FROM P TO P, since INT64);
---- ok
-STATEMENT CREATE (:P {id:1, name:'Alice', age:30}), (:P {id:2, name:'Bob', age:20}), (:P {id:3, name:'Carol', age:40});
---- ok

# SET a scalar property; the RETURN in the same statement reflects the new value.
-STATEMENT MATCH (p:P) WHERE p.id=1 SET p.age = 31 RETURN p.age
---- 1
31
-STATEMENT MATCH (p:P) WHERE p.id=1 RETURN p.age
---- 1
31

# SET coerces the value to the column's declared type (INT64 -> DOUBLE).
-STATEMENT MATCH (p:P) WHERE p.id=1 SET p.score = 13 RETURN p.score
---- 1
13.000000

# SET a property to NULL.
-STATEMENT MATCH (p:P) WHERE p.id=2 SET p.name = NULL
---- ok
-STATEMENT MATCH (p:P) WHERE p.id=2 RETURN p.name
---- 1

# Whole-value `=` sets the listed properties (id=3's score was never set → NULL).
-STATEMENT MATCH (p:P) WHERE p.id=3 SET p = {name: 'X', age: 7}
---- ok
-STATEMENT MATCH (p:P) WHERE p.id=3 RETURN p.id, p.name, p.age, p.score
---- 1
3|X|7|

# Whole-value `=` merges: only listed properties change (C++ semantics; the
# Neo4j-ism `+=` is a parse error in both engines — ledger "set-plus-equals").
-STATEMENT MATCH (p:P) WHERE p.id=3 SET p = {score: 1.5}
---- ok
-STATEMENT MATCH (p:P) WHERE p.id=3 SET p += {score: 2.5}
---- error
Parser exception: Invalid input <MATCH (p:P) WHERE p.id=3 SET p +>: expected rule oC_SingleQuery (line: 1, offset: 31)
"MATCH (p:P) WHERE p.id=3 SET p += {score: 2.5}"
                                ^
-STATEMENT MATCH (p:P) WHERE p.id=3 RETURN p.name, p.age, p.score
---- 1
X|7|1.500000

# Setting the primary key is a binder error (`=` property and whole-value forms).
-STATEMENT MATCH (p:P) WHERE p.id=1 SET p.id = 99
---- error
Binder exception: Cannot set property id in table P because it is used as primary key. Try delete and then insert.
-STATEMENT MATCH (p:P) WHERE p.id=1 SET p = {id: 99}
---- error
Binder exception: Cannot set property id in table P because it is used as primary key. Try delete and then insert.

# A node with a connected edge cannot be plain-deleted; the rel can; then the node.
-STATEMENT MATCH (a:P {id:1}), (b:P {id:2}) CREATE (a)-[:K {since:2020}]->(b)
---- ok
-STATEMENT MATCH (a:P {id:1}) DELETE a
---- error
Runtime exception: Node(nodeOffset: 0) has connected edges in table K in the fwd direction, which cannot be deleted. Please delete the edges first or try DETACH DELETE.
-STATEMENT MATCH (:P {id:1})-[e:K]->(:P) DELETE e
---- ok
-STATEMENT MATCH (a:P {id:1}) DELETE a
---- ok
-STATEMENT MATCH (p:P) RETURN COUNT(*)
---- 1
2

# DETACH DELETE removes incident edges then the node; RETURN sees the deleted value.
-STATEMENT MATCH (a:P {id:2}), (b:P {id:3}) CREATE (a)-[:K]->(b)
---- ok
-STATEMENT MATCH (b:P {id:3}) DETACH DELETE b RETURN b.id
---- 1
3
-STATEMENT MATCH (a:P)-[e:K]->(b:P) RETURN COUNT(*)
---- 1
0

# Write before WITH: a CREATE in a non-terminal part, carried forward.
-STATEMENT CREATE (x:P {id:10, name:'Z'}) WITH x MATCH (p:P) RETURN x.name, COUNT(*)
---- 1
Z|2

-CASE Transactions

-STATEMENT CREATE NODE TABLE P(id INT64, name STRING, PRIMARY KEY(id));
---- ok
-STATEMENT CREATE (:P {id:1, name:'a'}), (:P {id:2, name:'b'});
---- ok

# ROLLBACK undoes a SET (the change is visible within the transaction first).
-STATEMENT BEGIN TRANSACTION
---- ok
-STATEMENT MATCH (p:P) WHERE p.id=1 SET p.name = 'CHANGED'
---- ok
-STATEMENT MATCH (p:P) WHERE p.id=1 RETURN p.name
---- 1
CHANGED
-STATEMENT ROLLBACK
---- ok
-STATEMENT MATCH (p:P) WHERE p.id=1 RETURN p.name
---- 1
a

# COMMIT keeps a DELETE.
-STATEMENT BEGIN TRANSACTION
---- ok
-STATEMENT MATCH (p:P) WHERE p.id=2 DELETE p
---- ok
-STATEMENT COMMIT
---- ok
-STATEMENT MATCH (p:P) RETURN COUNT(*)
---- 1
1

# ROLLBACK undoes a DELETE (the node and its primary key come back).
-STATEMENT BEGIN TRANSACTION
---- ok
-STATEMENT MATCH (p:P) WHERE p.id=1 DELETE p
---- ok
-STATEMENT MATCH (p:P) RETURN COUNT(*)
---- 1
0
-STATEMENT ROLLBACK
---- ok
-STATEMENT MATCH (p:P) RETURN COUNT(*)
---- 1
1

# Control errors outside a transaction.
-STATEMENT COMMIT
---- error
No active transaction for COMMIT.
-STATEMENT ROLLBACK
---- error
No active transaction for ROLLBACK.

# An error inside a transaction aborts it (the prior SET is rolled back).
-STATEMENT BEGIN TRANSACTION
---- ok
-STATEMENT MATCH (p:P) WHERE p.id=1 SET p.name = 'X'
---- ok
-STATEMENT MATCH (p:P) SET p.id = 5
---- error
Binder exception: Cannot set property id in table P because it is used as primary key. Try delete and then insert.
-STATEMENT COMMIT
---- error
No active transaction for COMMIT.
-STATEMENT MATCH (p:P) WHERE p.id=1 RETURN p.name
---- 1
a

# A freshly-created *named* rel is projectable (CREATE (a)-[e:R]->(b) RETURN e).
# Within the creating statement its id renders with Kùzu's transaction-local 2^62
# offset (4611686018427387904); the next statement sees the dense offset.
-CASE CreateRelProjectTxnLocalId
-STATEMENT CREATE NODE TABLE P(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE REL TABLE K(FROM P TO P, w INT64)
---- ok
-STATEMENT CREATE (:P {id: 1})
---- ok
-STATEMENT CREATE (:P {id: 2})
---- ok
-STATEMENT MATCH (a:P {id: 1}), (b:P {id: 2}) CREATE (a)-[e:K {w: 9}]->(b) RETURN id(e), e.w
---- 1
1:4611686018427387904|9
-STATEMENT MATCH (a:P)-[e:K]->(b:P) RETURN id(e), e.w
---- 1
1:0|9

# CREATE with a NULL endpoint (from an OPTIONAL MATCH that didn't match) is a
# no-op: one row, the rel variable NULL, and no relationship is created.
-CASE CreateRelNullEndpointSkips
-STATEMENT CREATE NODE TABLE P(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE REL TABLE K(FROM P TO P)
---- ok
-STATEMENT CREATE (:P {id: 1})
---- ok
-STATEMENT OPTIONAL MATCH (a:P), (b:P) WHERE a.id = 1 AND b.id = 99 CREATE (a)-[e:K]->(b) RETURN id(e)
---- 1

-STATEMENT MATCH (a:P)-[e:K]->(b:P) RETURN COUNT(*)
---- 1
0

# An unlabeled rel pattern over a database with zero rel tables is a no-op
# (the extend over zero candidate tables yields zero rows), not a bind error.
-CASE DeleteRelEmptyDB
-STATEMENT MATCH ()-[e]->() DELETE e
---- ok

# Nodes exist but there are no rel tables: the DELETE is a no-op and the nodes
# survive untouched.
-CASE DeleteRelNoRelTablesNodesSurvive
-STATEMENT CREATE NODE TABLE P(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE (:P {id: 1}), (:P {id: 2})
---- ok
-STATEMENT MATCH ()-[e]->() DELETE e
---- ok
-STATEMENT MATCH (p:P) RETURN COUNT(*)
---- 1
2

# A variable-length pattern over an empty database binds (no panic at the
# recursive-rel site) and yields zero rows.
-CASE RecursiveRelEmptyDB
-STATEMENT MATCH ()-[*1..3]->() RETURN COUNT(*)
---- 1
0

# Undirected CREATE rel is rejected with Kùzu's wording.
-CASE CreateUndirectedRelError
-STATEMENT CREATE NODE TABLE P(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE REL TABLE K(FROM P TO P)
---- ok
-STATEMENT CREATE (:P {id: 1})
---- ok
-STATEMENT CREATE (:P {id: 2})
---- ok
-STATEMENT MATCH (a:P {id: 1}), (b:P {id: 2}) CREATE (a)-[:K]-(b)
---- error
Binder exception: Create undirected relationship is not supported. Try create 2 directed relationships instead.
