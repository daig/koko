# Phase 0 — ORDER BY / SKIP / LIMIT and cross products (disconnected patterns).
-DATASET CSV empty

--

-CASE OrderSkipLimit
-STATEMENT CREATE NODE TABLE N(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE (:N {id: 3})
---- ok
-STATEMENT CREATE (:N {id: 1})
---- ok
-STATEMENT CREATE (:N {id: 2})
---- ok
-STATEMENT CREATE (:N {id: 5})
---- ok
-STATEMENT CREATE (:N {id: 4})
---- ok
-STATEMENT MATCH (n:N) RETURN n.id ORDER BY n.id
-CHECK_ORDER
---- 5
1
2
3
4
5
-STATEMENT MATCH (n:N) RETURN n.id ORDER BY n.id DESC LIMIT 2
-CHECK_ORDER
---- 2
5
4
-STATEMENT MATCH (n:N) RETURN n.id ORDER BY n.id SKIP 2 LIMIT 2
-CHECK_ORDER
---- 2
3
4

-CASE CrossProduct
-STATEMENT CREATE NODE TABLE A(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE NODE TABLE B(name STRING, PRIMARY KEY(name))
---- ok
-STATEMENT CREATE (:A {id: 1})
---- ok
-STATEMENT CREATE (:A {id: 2})
---- ok
-STATEMENT CREATE (:B {name: 'x'})
---- ok
-STATEMENT CREATE (:B {name: 'y'})
---- ok
-STATEMENT MATCH (a:A), (b:B) RETURN a.id, b.name
---- 4
1|x
1|y
2|x
2|y
-STATEMENT MATCH (a:A), (b:B) WHERE a.id = 1 RETURN a.id, b.name
---- 2
1|x
1|y
