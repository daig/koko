# Phase 0 — hash join (P3 step 7, koko-planner::optimize + koko-processor). A
# both-side equi-join conjunct sitting above a cross product (each side evaluable
# from one input) is rewritten into a hash join: the build (right) side is hashed by
# its key, the probe (left) side streams and looks up its matches — O(n·m) -> O(n+m).
# Result-preserving: every answer equals the cross-product + `=` filter, and a NULL
# key never matches (set KOKO_NO_OPTIMIZE=1 to verify the A/B).
-DATASET CSV empty

--

-CASE HashJoinValueEquality
-STATEMENT CREATE NODE TABLE P(id INT64, name STRING, team INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE (:P {id: 1, name: 'A', team: 10})
---- ok
-STATEMENT CREATE (:P {id: 2, name: 'B', team: 10})
---- ok
-STATEMENT CREATE (:P {id: 3, name: 'A', team: 20})
---- ok
-STATEMENT CREATE (:P {id: 4, name: 'C', team: 20})
---- ok
# equi-join on name: names A(1),B(2),A(3),C(4); a.name=b.name pairs =
# (1,1),(1,3),(3,1),(3,3),(2,2),(4,4) = 6.
-STATEMENT MATCH (a:P), (b:P) WHERE a.name = b.name RETURN count(*)
---- 1
6
# project the join with a residual `<` filter (re-materialized above the hash join).
-STATEMENT MATCH (a:P), (b:P) WHERE a.name = b.name AND a.id < b.id RETURN a.id, b.id
---- 1
1|3
# a multi-key join (name AND team): only the self-pairs match (no two rows share both).
-STATEMENT MATCH (a:P), (b:P) WHERE a.name = b.name AND a.team = b.team RETURN a.id, b.id
---- 4
1|1
2|2
3|3
4|4
# equi-join on team: team 10 = {1,2}, team 20 = {3,4}; 2^2 + 2^2 = 8.
-STATEMENT MATCH (a:P), (b:P) WHERE a.team = b.team RETURN count(*)
---- 1
8
# the projected form of the same team join (8 ordered pairs).
-STATEMENT MATCH (a:P), (b:P) WHERE a.team = b.team RETURN a.id, b.id
---- 8
1|1
1|2
2|1
2|2
3|3
3|4
4|3
4|4
# swapped operand order (build-side expr on the left) joins identically.
-STATEMENT MATCH (a:P), (b:P) WHERE b.name = a.name AND a.id < b.id RETURN a.id, b.id
---- 1
1|3
# a NULL join key never matches: id 5 has no name, so it pairs with nobody (not even
# itself), exactly as `null = null` filters out — the name-join count stays 6.
-STATEMENT CREATE (:P {id: 5, team: 30})
---- ok
-STATEMENT MATCH (a:P), (b:P) WHERE a.name = b.name RETURN count(*)
---- 1
6
# a non-equality both-side predicate is NOT a hash join — it stays a filtered cross
# product, and must still be correct (a.id < b.id over the 5 nodes = 10 pairs).
-STATEMENT MATCH (a:P), (b:P) WHERE a.id < b.id RETURN count(*)
---- 1
10
