# Phase 0 — relationship CREATE + MATCH extends (directed, reverse, rel values).
-DATASET CSV empty

--

-CASE FollowsGraph
-STATEMENT CREATE NODE TABLE User(name STRING, PRIMARY KEY(name))
---- ok
-STATEMENT CREATE REL TABLE Follows(FROM User TO User, since INT64)
---- ok
-STATEMENT CREATE (:User {name: 'Adam'})
---- ok
-STATEMENT CREATE (:User {name: 'Beth'})
---- ok
-STATEMENT CREATE (:User {name: 'Cara'})
---- ok
-STATEMENT MATCH (a:User), (b:User) WHERE a.name = 'Adam' AND b.name = 'Beth' CREATE (a)-[:Follows {since: 2020}]->(b)
---- ok
-STATEMENT MATCH (a:User), (b:User) WHERE a.name = 'Adam' AND b.name = 'Cara' CREATE (a)-[:Follows {since: 2021}]->(b)
---- ok
-STATEMENT MATCH (a:User)-[:Follows]->(b:User) WHERE a.name = 'Adam' RETURN b.name
---- 2
Beth
Cara
-STATEMENT MATCH (a:User)-[e:Follows]->(b:User) RETURN a.name, e.since, b.name
---- 2
Adam|2020|Beth
Adam|2021|Cara
-STATEMENT MATCH (a:User)<-[:Follows]-(b:User) WHERE a.name = 'Beth' RETURN b.name
---- 1
Adam
-STATEMENT MATCH (a:User)-[e:Follows]->(b:User) WHERE b.name = 'Beth' RETURN e
---- 1
(0:0)-{_LABEL: Follows, _ID: 1:0, since: 2020}->(0:1)

-CASE CreateNewNodesAndRel
-STATEMENT CREATE NODE TABLE U(name STRING, PRIMARY KEY(name))
---- ok
-STATEMENT CREATE REL TABLE Knows(FROM U TO U, weight INT64)
---- ok
-STATEMENT CREATE (a:U {name: 'x'})-[:Knows {weight: 7}]->(b:U {name: 'y'})
---- ok
-STATEMENT MATCH (a:U)-[e:Knows]->(b:U) RETURN a.name, b.name, e.weight
---- 1
x|y|7

-CASE TwoHopPath
-STATEMENT CREATE NODE TABLE U(name STRING, PRIMARY KEY(name))
---- ok
-STATEMENT CREATE REL TABLE Knows(FROM U TO U, n INT64)
---- ok
-STATEMENT CREATE (:U {name: 'a'})
---- ok
-STATEMENT CREATE (:U {name: 'b'})
---- ok
-STATEMENT CREATE (:U {name: 'c'})
---- ok
-STATEMENT MATCH (a:U), (b:U) WHERE a.name='a' AND b.name='b' CREATE (a)-[:Knows {n: 1}]->(b)
---- ok
-STATEMENT MATCH (a:U), (b:U) WHERE a.name='b' AND b.name='c' CREATE (a)-[:Knows {n: 2}]->(b)
---- ok
-STATEMENT MATCH (a:U)-[:Knows]->(b:U)-[:Knows]->(c:U) RETURN a.name, b.name, c.name
---- 1
a|b|c
