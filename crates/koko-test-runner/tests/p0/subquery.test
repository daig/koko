-DATASET CSV empty
--
# Hermetic D5b gate: EXISTS {} / COUNT {} subqueries. Runs under `cargo test`.
# Graph: Alice -[:Knows]-> Bob, Alice -[:Knows]-> Carol; Bob/Carol no outgoing.

-CASE Subquery
-STATEMENT CREATE NODE TABLE Person(name STRING, id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE REL TABLE Knows(FROM Person TO Person)
---- ok
-STATEMENT CREATE (:Person {name:'Alice', id:1})
---- ok
-STATEMENT CREATE (:Person {name:'Bob', id:2})
---- ok
-STATEMENT CREATE (:Person {name:'Carol', id:3})
---- ok
-STATEMENT MATCH (a:Person {id:1}), (b:Person {id:2}) CREATE (a)-[:Knows]->(b)
---- ok
-STATEMENT MATCH (a:Person {id:1}), (b:Person {id:3}) CREATE (a)-[:Knows]->(b)
---- ok
# EXISTS in WHERE (correlated to the outer a).
-STATEMENT MATCH (a:Person) WHERE EXISTS { MATCH (a)-[:Knows]->(b:Person) } RETURN a.name
---- 1
Alice
# NOT EXISTS.
-STATEMENT MATCH (a:Person) WHERE NOT EXISTS { MATCH (a)-[:Knows]->(b:Person) } RETURN a.name
---- 2
Bob
Carol
# A WHERE inside the subquery (only Alice knows Carol).
-STATEMENT MATCH (a:Person) WHERE EXISTS { MATCH (a)-[:Knows]->(b:Person) WHERE b.name = 'Carol' } RETURN a.name
---- 1
Alice
# COUNT subquery in RETURN (out-degree).
-STATEMENT MATCH (a:Person) RETURN a.name, COUNT { MATCH (a)-[:Knows]->(b:Person) }
---- 3
Alice|2
Bob|0
Carol|0
# COUNT subquery in WHERE.
-STATEMENT MATCH (a:Person) WHERE COUNT { MATCH (a)-[:Knows]->(b:Person) } = 2 RETURN a.name
---- 1
Alice
# A correlated WHERE inside the COUNT subquery.
-STATEMENT MATCH (a:Person) RETURN a.name, COUNT { MATCH (b:Person) WHERE b.id > a.id }
---- 3
Alice|2
Bob|1
Carol|0
# Two subqueries in one RETURN.
-STATEMENT MATCH (a:Person) RETURN a.name, EXISTS { MATCH (a)-[:Knows]->(x:Person) } AS e, COUNT { MATCH (a)-[:Knows]->(y:Person) } AS c ORDER BY a.id
-CHECK_ORDER
---- 3
Alice|True|2
Bob|False|0
Carol|False|0

-CASE NestedSubqueryDeferred
-STATEMENT CREATE NODE TABLE Person(name STRING, id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE REL TABLE Knows(FROM Person TO Person)
---- ok
-STATEMENT CREATE (:Person {name:'Alice', id:1})
---- ok
# A subquery inside a subquery's WHERE evaluates per inner row (oracle: 0
# on this single-node graph).
-STATEMENT MATCH (a:Person) WHERE EXISTS { MATCH (a)-[:Knows]->(b:Person) WHERE EXISTS { MATCH (b)-[:Knows]->(c:Person) } } RETURN COUNT(*)
---- 1
0
