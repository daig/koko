-DATASET CSV empty
--
-CASE UInt128Casts
-STATEMENT RETURN CAST(5 AS UINT128)
---- 1
5
-STATEMENT RETURN CAST("340282366920938463463374607431768211455" AS UINT128)
---- 1
340282366920938463463374607431768211455
-STATEMENT RETURN CAST(200000000000000000000000000000000000000 AS UINT128)
---- 1
200000000000000000000000000000000000000

-CASE UInt128Literal
-STATEMENT RETURN 200000000000000000000000000000000000000
---- 1
200000000000000000000000000000000000000

-CASE UInt128Arithmetic
-STATEMENT RETURN CAST(10 AS UINT128) + CAST(20 AS UINT128)
---- 1
30
-STATEMENT RETURN CAST(10 AS UINT128) * CAST(7 AS UINT128)
---- 1
70
-STATEMENT RETURN CAST(100 AS UINT128) - CAST(40 AS UINT128)
---- 1
60
-STATEMENT RETURN CAST(340282366920938463463374607431768211455 AS UINT128) + CAST(1 AS UINT128)
---- error
Overflow exception: UINT128 is out of range: cannot add.

-CASE UInt128AbsAndCompare
-STATEMENT RETURN abs(CAST(7 AS UINT128))
---- 1
7
-STATEMENT RETURN CAST(5 AS UINT128) < CAST(9 AS UINT128)
---- 1
True
-STATEMENT RETURN CAST(9 AS UINT128) = 9
---- 1
True
