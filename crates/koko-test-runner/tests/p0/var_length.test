# Hermetic variable-length / recursive-path fixtures (P1-E Wave D).
# Graph: nodes id 10,20,30 (offsets 0,1,2); directed edges 10->20 (w5), 20->30
# (w7), 10->30 (w9). Rel table E is the only rel table → table id 1.
-DATASET CSV empty

--

-CASE VarLength

-STATEMENT CREATE NODE TABLE N(id INT64, PRIMARY KEY(id));
---- ok
-STATEMENT CREATE REL TABLE E(FROM N TO N, w INT64);
---- ok
-STATEMENT CREATE (:N {id: 10}), (:N {id: 20}), (:N {id: 30});
---- ok
-STATEMENT MATCH (a:N {id: 10}), (b:N {id: 20}) CREATE (a)-[:E {w: 5}]->(b);
---- ok
-STATEMENT MATCH (a:N {id: 20}), (b:N {id: 30}) CREATE (a)-[:E {w: 7}]->(b);
---- ok
-STATEMENT MATCH (a:N {id: 10}), (b:N {id: 30}) CREATE (a)-[:E {w: 9}]->(b);
---- ok

# 1..2 directed: 10->20, 10->30 (shortcut), 10->20->30.
-STATEMENT MATCH (a:N {id: 10})-[e:E*1..2]->(b:N) RETURN b.id
---- 3
20
30
30
-STATEMENT MATCH (a:N {id: 10})-[e:E*1..2]->(b:N) RETURN COUNT(*)
---- 1
3

# Exact length and the rel-value length() accessor.
-STATEMENT MATCH (a:N {id: 10})-[e:E*2..2]->(b:N) RETURN b.id, length(e)
---- 1
30|2

# nodes()/rels()/properties() over the recursive-rel value (intermediates only).
-STATEMENT MATCH (a:N {id: 10})-[e:E*2..2]->(b:N) RETURN properties(nodes(e), 'id'), properties(rels(e), 'w'), properties(rels(e), '_id')
---- 1
[20]|[5,7]|[1:0,1:1]

# The whole recursive-rel value renders as {_NODES, _RELS}.
-STATEMENT MATCH (a:N {id: 10})-[e:E*2..2]->(b:N) RETURN e
---- 1
{_NODES: [{_ID: 0:1, _LABEL: N, id: 20}], _RELS: [(0:0)-{_LABEL: E, _ID: 1:0, w: 5}->(0:1),(0:1)-{_LABEL: E, _ID: 1:1, w: 7}->(0:2)]}

# A named path includes both endpoints in nodes(p); length(p) is the hop count.
-STATEMENT MATCH p = (a:N {id: 10})-[e:E*2..2]->(b:N) RETURN length(p), properties(nodes(p), 'id')
---- 1
2|[10,20,30]

# Zero lower bound: a length-0 path is the start node itself (empty rel value).
-STATEMENT MATCH (a:N {id: 10})-[e:E*0..1]->(b:N) RETURN b.id, length(e)
---- 3
10|0
20|1
30|1
-STATEMENT MATCH (a:N {id: 10})-[e:E*0..0]->(b:N) RETURN e
---- 1
{_NODES: [], _RELS: []}

# SHORTEST: one row per reachable destination at its minimal distance.
-STATEMENT MATCH (a:N {id: 10})-[e:E* SHORTEST 1..3]->(b:N) RETURN b.id, length(e)
---- 2
20|1
30|1

# Undirected expansion follows edges in both directions.
-STATEMENT MATCH (a:N {id: 20})-[e:E*1..1]-(b:N) RETURN b.id
---- 2
10
30

# Per-step lambda: a relationship filter gates every edge (so the 2-hop path via
# the w=5/w=7 chain survives, but no path uses the w=9 shortcut).
-STATEMENT MATCH (a:N {id: 10})-[e:E*1..2 (r, _ | WHERE r.w < 8)]->(b:N) RETURN b.id, length(e)
---- 2
20|1
30|2

# A node filter gates intermediates only (end node 30 is not constrained); here
# requiring the intermediate id<>20 removes the 2-hop path through 20.
-STATEMENT MATCH (a:N {id: 10})-[e:E*1..2 (r, n | WHERE n.id <> 20)]->(b:N) RETURN b.id, length(e)
---- 2
20|1
30|1

# Lambda projection restricts which properties appear on intermediate rels.
-STATEMENT MATCH (a:N {id: 10})-[e:E*2..2 (r, n | {}, {})]->(b:N) RETURN e
---- 1
{_NODES: [{_ID: 0:1, _LABEL: N}], _RELS: [(0:0)-{_LABEL: E, _ID: 1:0}->(0:1),(0:1)-{_LABEL: E, _ID: 1:1}->(0:2)]}

# Inline `{prop: val}` filters every relationship in the path.
-STATEMENT MATCH (a:N {id: 10})-[e:E*1..2 {w: 5}]->(b:N) RETURN b.id, length(e)
---- 1
20|1

# An unsatisfiable upper<lower is a binder error.
-STATEMENT MATCH (a:N)-[e:E*2..1]->(b:N) RETURN COUNT(*)
---- error
Binder exception: Lower bound of rel e is greater than upperBound.

# A recursive rel cannot be created.
-STATEMENT MATCH (a:N {id: 10}), (b:N {id: 30}) CREATE (a)-[e:E*2]->(b)
---- error
Binder exception: Cannot create recursive rel e.
