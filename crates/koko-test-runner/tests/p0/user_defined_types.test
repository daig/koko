# Phase 2 — CREATE TYPE (user-defined type aliases) usable as column/cast types.
-DATASET CSV empty

--

-CASE PrimitiveAliasAndCast
-STATEMENT CREATE TYPE SMALLINT AS INT32
---- ok
-STATEMENT CREATE TYPE BIGINT AS INT64
---- ok
-STATEMENT RETURN CAST(CAST(3 AS SMALLINT) AS BIGINT)
---- 1
3
-STATEMENT CREATE NODE TABLE P(ID SMALLINT, AGE BIGINT, PRIMARY KEY(ID))
---- ok
-STATEMENT CREATE (:P {ID: 5, AGE: 20})
---- ok
-STATEMENT MATCH (p:P) RETURN p.*
---- 1
5|20

# A numeric struct avoids the pre-existing top-level-STRUCT string-quoting nuance
# (KNOWN_GAPS); the point of this case is that the alias resolves to the STRUCT.
-CASE StructAlias
-STATEMENT CREATE TYPE POINT AS STRUCT(x int64, y int64)
---- ok
-STATEMENT CREATE NODE TABLE node(id INT64, p POINT, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE (:node {id: 1, p: {x: 3, y: 4}})
---- ok
-STATEMENT MATCH (n:node) RETURN n.*
---- 1
1|{x: 3, y: 4}
-STATEMENT CALL TABLE_INFO('node') RETURN *
---- 2
0|id|INT64|NULL|True
1|p|STRUCT(x INT64, y INT64)|NULL|False

# A UDT alias resolves when nested inside a STRUCT / list type (not just at the
# top level), and a struct/list literal coerces field-wise to the declared type.
-CASE NestedAliasInStructAndList
-STATEMENT CREATE TYPE LENGTH AS INT64
---- ok
-STATEMENT CREATE TYPE HEIGHT AS INT32
---- ok
-STATEMENT CREATE NODE TABLE PERSON (name string, info struct(h HEIGHT, l LENGTH), heights HEIGHT[], primary key(name))
---- ok
-STATEMENT CALL TABLE_INFO('PERSON') RETURN *
---- 3
0|name|STRING|NULL|True
1|info|STRUCT(h INT32, l INT64)|NULL|False
2|heights|INT32[]|NULL|False
-STATEMENT CREATE (:PERSON {name: 'a', info: {h: 32, l: 5}, heights: [1, 2, 3]})
---- ok
-STATEMENT MATCH (p:PERSON) RETURN p.info, p.heights
---- 1
{h: 32, l: 5}|[1,2,3]

-CASE AliasOfAlias
-STATEMENT CREATE TYPE SMALLINT AS INT32
---- ok
-STATEMENT CREATE TYPE TINY AS SMALLINT
---- ok
-STATEMENT RETURN CAST(7 AS TINY)
---- 1
7

-CASE DuplicateType
-STATEMENT CREATE TYPE FOO AS INT32
---- ok
-STATEMENT CREATE TYPE FOO AS INT64
---- error
Binder exception: Duplicated type name: FOO.
