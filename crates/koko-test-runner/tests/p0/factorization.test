# Phase 0 — factorization (P3 step 6, koko-planner::optimize + koko-processor).
# A collapsible fan-out suffix — a pattern tail whose introduced variables are never
# read, only counted — is folded into a per-row *multiplicity* instead of being
# materialized as a cross-product. It is result-preserving: every answer here equals
# what a fully materialized fan-out gives (set KOKO_NO_OPTIMIZE=1 to verify the A/B).
-DATASET CSV empty

--

-CASE FactorizedAggregateOverFanout
-STATEMENT CREATE NODE TABLE P(id INT64, age INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE REL TABLE K(FROM P TO P)
---- ok
-STATEMENT UNWIND range(0, 3) AS i CREATE (:P {id: i, age: 10 + i})
---- ok
# edges 0->1, 0->2, 0->3, 1->2  (out-degrees: 0 has 3, 1 has 1; 4 edges total)
-STATEMENT MATCH (a:P), (b:P) WHERE a.id = 0 AND b.id = 1 CREATE (a)-[:K]->(b)
---- ok
-STATEMENT MATCH (a:P), (b:P) WHERE a.id = 0 AND b.id = 2 CREATE (a)-[:K]->(b)
---- ok
-STATEMENT MATCH (a:P), (b:P) WHERE a.id = 0 AND b.id = 3 CREATE (a)-[:K]->(b)
---- ok
-STATEMENT MATCH (a:P), (b:P) WHERE a.id = 1 AND b.id = 2 CREATE (a)-[:K]->(b)
---- ok
# count(*): `b` and the rel are unread, so the extend collapses the fan-out.
-STATEMENT MATCH (a:P)-[:K]->(b:P) RETURN count(*)
---- 1
4
# sum/avg fold the (flat) head value with the suffix multiplicity:
# a=0 (age 10) x3 + a=1 (age 11) x1 = 41 over 4 tuples.
-STATEMENT MATCH (a:P)-[:K]->(b:P) RETURN sum(a.age)
---- 1
41
-STATEMENT MATCH (a:P)-[:K]->(b:P) RETURN avg(a.age)
---- 1
10.250000
# grouped by the flat head — `b` collapses into each group's count.
-STATEMENT MATCH (a:P)-[:K]->(b:P) RETURN a.id, count(*)
---- 2
0|3
1|1
# the endpoint IS read here -> ordinary fan-out (not collapsed), still correct
# (in-degrees: 1 from {0}, 2 from {0,1}, 3 from {0}).
-STATEMENT MATCH (a:P)-[:K]->(b:P) RETURN b.id, count(*)
---- 3
1|1
2|2
3|1
# count(DISTINCT head) ignores the multiplicity (one distinct `a` though it stands
# for three tuples).
-STATEMENT MATCH (a:P)-[:K]->(b:P) WHERE a.id = 0 RETURN count(DISTINCT a.id)
---- 1
1
# a head with no matching neighbor contributes nothing (count 0 -> row dropped).
-STATEMENT MATCH (a:P)-[:K]->(b:P) WHERE a.id = 3 RETURN count(*)
---- 1
0
# variable-length collapsible: count paths from 0 of length 1..2 (the path value and
# end node are unread). Length 1: 0->{1,2,3} = 3; length 2: 0->1->2 = 1; total 4.
-STATEMENT MATCH (a:P)-[:K*1..2]->(b:P) WHERE a.id = 0 RETURN count(*)
---- 1
4
# a bare disconnected cross product (no extend to collapse) still counts correctly:
# |P| x |P| = 4 x 4 = 16.
-STATEMENT MATCH (a:P), (b:P) RETURN count(*)
---- 1
16
