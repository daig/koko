-DATASET CSV empty
--
-CASE StructLit
-STATEMENT RETURN {a:1, b:2}
---- 1
{a: 1, b: 2}
-STATEMENT RETURN {a:1, b:{c: 'C', d: 'D'}}
---- 1
{a: 1, b: {c: C, d: D}}
-STATEMENT RETURN {"foo": "bar"}
---- 1
{foo: bar}
-STATEMENT RETURN struct_extract({a:1, b:2}, 'b')
---- 1
2
-CASE MapFns
-STATEMENT RETURN map_extract(map([4,5,7], [true, false, true]), 5)
---- 1
[False]
-STATEMENT RETURN map_extract(map(['a', 'c', 'e'], [4, 3, 1]), 'c')
---- 1
[3]
-STATEMENT RETURN map_keys(map(['a','b'], [1,2])), map_values(map(['a','b'], [1,2]))
---- 1
[a,b]|[1,2]
-STATEMENT RETURN map_extract(map([{a: 3, b: [1, 2, 5]}, {a: 6, b: [1,3]}], [4.3, 5.2]), {a: 3, b: [1,2,5]})
---- 1
[4.300000]
