# Strongly connected components preserve selected relationship direction, bind directly to
# statement-selected tables, and emit compact IDs ordered by minimum InternalId.
-DATASET CSV empty

--

-CASE EmptySelectionIsolatedAndChunkedEmission
-STATEMENT CREATE NODE TABLE N(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE REL TABLE E(FROM N TO N)
---- ok
-STATEMENT CALL strongly_connected_components([], []) YIELD node, component_id RETURN count(*)
---- 1
0
-STATEMENT UNWIND range(0, 2050) AS id CREATE (:N {id: id})
---- ok
-STATEMENT CALL strongly_connected_components(['N'], ['E']) YIELD component_id RETURN count(*), min(component_id), max(component_id)
---- 1
2051|0|2050
-STATEMENT CALL strongly_connected_components(['N'], ['E']) YIELD node, component_id WHERE node.id IN [0,1024,2050] RETURN node.id, component_id ORDER BY node.id
-CHECK_ORDER
---- 3
0|0
1024|1024
2050|2050
-STATEMENT CALL show_functions() WHERE name = 'STRONGLY_CONNECTED_COMPONENTS' RETURN type, signature
---- 1
ALGORITHM FUNCTION|(LIST<STRING>,LIST<STRING>) -> TABLE(node NODE, component_id INT64)

-CASE DirectedChainsCyclesAndNestedSccDag
-STATEMENT CREATE NODE TABLE N(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE REL TABLE E(FROM N TO N)
---- ok
-STATEMENT UNWIND range(0, 9) AS id CREATE (:N {id: id})
---- ok
-STATEMENT MATCH (a:N), (b:N) WHERE (a.id = 0 AND b.id = 1) OR (a.id = 1 AND b.id = 2) OR (a.id = 2 AND b.id = 0) OR (a.id = 2 AND b.id = 3) OR (a.id = 3 AND b.id = 4) OR (a.id = 4 AND b.id = 5) OR (a.id = 5 AND b.id = 4) OR (a.id = 5 AND b.id = 6) OR (a.id = 6 AND b.id = 7) OR (a.id = 7 AND b.id = 8) OR (a.id = 8 AND b.id = 9) OR (a.id = 9 AND b.id = 7) CREATE (a)-[:E]->(b)
---- ok
-STATEMENT MATCH (a:N), (b:N) WHERE a.id = 4 AND b.id = 5 CREATE (a)-[:E]->(b), (a)-[:E]->(b)
---- ok
-STATEMENT MATCH (n:N) WHERE n.id = 6 CREATE (n)-[:E]->(n)
---- ok
-STATEMENT CALL strongly_connected_components(['N'], ['E']) YIELD node, component_id RETURN node.id, component_id ORDER BY node.id
-CHECK_ORDER
---- 10
0|0
1|0
2|0
3|1
4|2
5|2
6|3
7|4
8|4
9|4
-STATEMENT CALL strongly_connected_components(['N'], ['E']) YIELD node, component_id WITH component_id, min(node.id) AS minimum, count(*) AS size RETURN component_id, minimum, size ORDER BY component_id
-CHECK_ORDER
---- 5
0|0|3
1|3|1
2|4|2
3|6|1
4|7|3

-CASE DisconnectedMultiTableSelectionAndCanonicalIds
-STATEMENT CREATE NODE TABLE Person(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE NODE TABLE City(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE REL TABLE Links(FROM Person TO Person, FROM Person TO City, FROM City TO Person)
---- ok
-STATEMENT CREATE (:Person {id: 20}), (:Person {id: 21}), (:City {id: 10}), (:City {id: 11})
---- ok
-STATEMENT MATCH (p:Person), (c:City) WHERE p.id = 20 AND c.id = 10 CREATE (p)-[:Links]->(c), (p)<-[:Links]-(c)
---- ok
-STATEMENT CALL strongly_connected_components(['City','Person'], ['Links']) YIELD node, component_id RETURN label(node), node.id, component_id ORDER BY label(node), node.id
-CHECK_ORDER
---- 4
City|10|0
City|11|2
Person|20|0
Person|21|1
-STATEMENT CALL strongly_connected_components(['City','Person'], []) YIELD node, component_id RETURN label(node), node.id, component_id ORDER BY label(node), node.id
-CHECK_ORDER
---- 4
City|10|2
City|11|3
Person|20|0
Person|21|1

-CASE ComposableNameBasedYield
-STATEMENT CREATE NODE TABLE N(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE REL TABLE E(FROM N TO N)
---- ok
-STATEMENT CREATE (:N {id: 0}), (:N {id: 1}), (:N {id: 2})
---- ok
-STATEMENT MATCH (a:N), (b:N) WHERE (a.id = 0 AND b.id = 1) OR (a.id = 1 AND b.id = 0) OR (a.id = 1 AND b.id = 2) CREATE (a)-[:E]->(b)
---- ok
-STATEMENT UNWIND [10,20] AS outer CALL strongly_connected_components(['N'], ['E']) YIELD component_id AS cid, node AS member WHERE cid = 0 RETURN outer, member.id, cid ORDER BY outer, member.id
-CHECK_ORDER
---- 4
10|0|0
10|1|0
20|0|0
20|1|0
-STATEMENT CALL strongly_connected_components(['N'], ['E']) YIELD component_id WHERE component_id = 1 RETURN count(*), max(component_id)
---- 1
1|1
-STATEMENT CALL strongly_connected_components(['N'], ['E']) YIELD group_id RETURN group_id
---- error
Binder exception: Unknown table function output variable name: group_id.

-CASE TransactionVisibility
-STATEMENT CREATE NODE TABLE N(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE REL TABLE E(FROM N TO N)
---- ok
-STATEMENT CREATE (:N {id: 0}), (:N {id: 1})
---- ok
-STATEMENT MATCH (a:N), (b:N) WHERE a.id = 0 AND b.id = 1 CREATE (a)-[:E]->(b)
---- ok
-STATEMENT CALL strongly_connected_components(['N'], ['E']) YIELD node, component_id RETURN node.id, component_id ORDER BY node.id
-CHECK_ORDER
---- 2
0|0
1|1
-STATEMENT BEGIN TRANSACTION
---- ok
-STATEMENT MATCH (a:N), (b:N) WHERE a.id = 1 AND b.id = 0 CREATE (a)-[:E]->(b)
---- ok
-STATEMENT CALL strongly_connected_components(['N'], ['E']) YIELD node, component_id RETURN node.id, component_id ORDER BY node.id
-CHECK_ORDER
---- 2
0|0
1|0
-STATEMENT COMMIT
---- ok
-STATEMENT BEGIN TRANSACTION
---- ok
-STATEMENT MATCH (a:N)-[edge:E]->(b:N) WHERE a.id = 1 AND b.id = 0 DELETE edge
---- ok
-STATEMENT CALL strongly_connected_components(['N'], ['E']) YIELD node, component_id RETURN node.id, component_id ORDER BY node.id
-CHECK_ORDER
---- 2
0|0
1|1
-STATEMENT ROLLBACK
---- ok
-STATEMENT CALL strongly_connected_components(['N'], ['E']) YIELD node, component_id RETURN node.id, component_id ORDER BY node.id
-CHECK_ORDER
---- 2
0|0
1|0
-STATEMENT BEGIN TRANSACTION
---- ok
-STATEMENT MATCH (n:N) WHERE n.id = 1 DETACH DELETE n
---- ok
-STATEMENT CALL strongly_connected_components(['N'], ['E']) YIELD node, component_id RETURN node.id, component_id
---- 1
0|0
-STATEMENT ROLLBACK
---- ok

-CASE GraphSelectionValidation
-STATEMENT CREATE NODE TABLE N(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE NODE TABLE M(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE REL TABLE E(FROM N TO M)
---- ok
-STATEMENT CALL strongly_connected_components(['N']) YIELD node, component_id RETURN node
---- error
Binder exception: Function strongly_connected_components did not receive correct arguments:
Actual:   (1 arguments)
Expected: (LIST<STRING>,LIST<STRING>)
-STATEMENT CALL strongly_connected_components('N', ['E']) YIELD node, component_id RETURN node
---- error
Binder exception: Argument 1 of strongly_connected_components must be LIST<STRING>, but STRING was provided.
-STATEMENT CALL strongly_connected_components([1], ['E']) YIELD node, component_id RETURN node
---- error
Binder exception: Element 1 of argument 1 to strongly_connected_components must be STRING, but INT64 was provided.
-STATEMENT CALL strongly_connected_components(['N','N'], []) YIELD node, component_id RETURN node
---- error
Binder exception: Duplicate node table in graph selection: N.
-STATEMENT CALL strongly_connected_components(['N','M'], ['E','E']) YIELD node, component_id RETURN node
---- error
Binder exception: Duplicate relationship table in graph selection: E.
-STATEMENT CALL strongly_connected_components(['Missing'], []) YIELD node, component_id RETURN node
---- error
Binder exception: Node table Missing does not exist.
-STATEMENT CALL strongly_connected_components(['N','M'], ['Missing']) YIELD node, component_id RETURN node
---- error
Binder exception: Relationship table Missing does not exist.
-STATEMENT CALL strongly_connected_components(['N'], ['E']) YIELD node, component_id RETURN node
---- error
Binder exception: Relationship table E references node table M, which is not in the graph selection.
