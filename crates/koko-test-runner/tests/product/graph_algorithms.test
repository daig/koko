# Built-in whole-graph algorithms bind explicit table selections and compose as ordinary
# read sources. Topological levels use directed Kahn frontiers over the statement snapshot.
-DATASET CSV empty

--

-CASE EmptySelectionAndIsolatedNodes
-STATEMENT CREATE NODE TABLE N(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE REL TABLE E(FROM N TO N)
---- ok
-STATEMENT CREATE (:N {id: 0}), (:N {id: 1}), (:N {id: 2})
---- ok
-STATEMENT CALL topological_levels([], []) YIELD node, level RETURN count(*)
---- 1
0
-STATEMENT CALL topological_levels(['N'], ['E']) YIELD node, level RETURN node.id, level ORDER BY node.id
-CHECK_ORDER
---- 3
0|0
1|0
2|0
-STATEMENT CALL show_functions() WHERE name = 'TOPOLOGICAL_LEVELS' RETURN type, signature
---- 1
ALGORITHM FUNCTION|(LIST<STRING>,LIST<STRING>) -> TABLE(node NODE, level INT64)

-CASE LayeredDagComposition
-STATEMENT CREATE NODE TABLE N(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE REL TABLE E(FROM N TO N)
---- ok
-STATEMENT UNWIND range(0, 7) AS id CREATE (:N {id: id})
---- ok
-STATEMENT MATCH (a:N), (b:N) WHERE a.id = 0 AND b.id IN [1,2] CREATE (a)-[:E]->(b)
---- ok
-STATEMENT MATCH (a:N), (b:N) WHERE (a.id = 1 OR a.id = 2) AND b.id = 3 CREATE (a)-[:E]->(b)
---- ok
-STATEMENT MATCH (a:N), (b:N) WHERE a.id = 4 AND b.id = 5 CREATE (a)-[:E]->(b)
---- ok
-STATEMENT MATCH (a:N), (b:N) WHERE a.id = 5 AND b.id = 6 CREATE (a)-[:E]->(b), (a)-[:E]->(b)
---- ok
-STATEMENT CALL topological_levels(['N'], ['E']) YIELD level AS depth, node AS ranked RETURN ranked.id, depth ORDER BY ranked.id
-CHECK_ORDER
---- 8
0|0
1|1
2|1
3|2
4|0
5|1
6|2
7|0
-STATEMENT CALL topological_levels(['N'], ['E']) YIELD level WHERE level >= 1 RETURN count(*), max(level)
---- 1
5|2

-CASE MultiTableRelationshipGroup
-STATEMENT CREATE NODE TABLE Person(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE NODE TABLE City(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE REL TABLE Links(FROM Person TO Person, FROM Person TO City)
---- ok
-STATEMENT CREATE (:Person {id: 0}), (:Person {id: 1}), (:City {id: 10})
---- ok
-STATEMENT MATCH (a:Person), (b:Person) WHERE a.id = 0 AND b.id = 1 CREATE (a)-[:Links]->(b)
---- ok
-STATEMENT MATCH (a:Person), (b:City) WHERE a.id = 0 AND b.id = 10 CREATE (a)-[:Links]->(b)
---- ok
-STATEMENT CALL topological_levels(['Person','City'], ['Links']) YIELD node, level RETURN label(node), node.id, level ORDER BY label(node), node.id
-CHECK_ORDER
---- 3
City|10|1
Person|0|0
Person|1|1

-CASE SelfLoopCycle
-STATEMENT CREATE NODE TABLE N(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE REL TABLE E(FROM N TO N)
---- ok
-STATEMENT CREATE (:N {id: 0})
---- ok
-STATEMENT MATCH (n:N) CREATE (n)-[:E]->(n)
---- ok
-STATEMENT CALL topological_levels(['N'], ['E']) YIELD node, level RETURN node.id, level
---- error
Runtime exception: Topological leveling requires an acyclic graph; 0 of 1 selected vertices were ranked.

-CASE CycleWithRankableComponent
-STATEMENT CREATE NODE TABLE N(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE REL TABLE E(FROM N TO N)
---- ok
-STATEMENT UNWIND range(0, 4) AS id CREATE (:N {id: id})
---- ok
-STATEMENT MATCH (a:N), (b:N) WHERE (a.id = 0 AND b.id = 1) OR (a.id = 1 AND b.id = 0) OR (a.id = 1 AND b.id = 2) OR (a.id = 2 AND b.id = 3) CREATE (a)-[:E]->(b)
---- ok
-STATEMENT CALL topological_levels(['N'], ['E']) YIELD node, level RETURN node.id, level
---- error
Runtime exception: Topological leveling requires an acyclic graph; 1 of 5 selected vertices were ranked.

-CASE PipelinesAndWorkers
-STATEMENT CREATE NODE TABLE N(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE REL TABLE E(FROM N TO N)
---- ok
-STATEMENT CREATE (:N {id: 0}), (:N {id: 1})
---- ok
-STATEMENT MATCH (a:N), (b:N) WHERE a.id = 0 AND b.id = 1 CREATE (a)-[:E]->(b)
---- ok
-STATEMENT UNWIND [10,20] AS outer CALL topological_levels(['N'], ['E']) YIELD node, level RETURN outer, node.id, level ORDER BY outer, node.id
-CHECK_ORDER
---- 4
10|0|0
10|1|1
20|0|0
20|1|1
-STATEMENT CALL threads=1
---- ok
-STATEMENT CALL topological_levels(['N'], ['E']) YIELD node, level RETURN node.id, level ORDER BY node.id
-CHECK_ORDER
---- 2
0|0
1|1
-STATEMENT CALL threads=4
---- ok
-STATEMENT CALL topological_levels(['N'], ['E']) YIELD node, level RETURN node.id, level ORDER BY node.id
-CHECK_ORDER
---- 2
0|0
1|1

-CASE TransactionVisibility
-STATEMENT CREATE NODE TABLE N(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE REL TABLE E(FROM N TO N)
---- ok
-STATEMENT CREATE (:N {id: 0}), (:N {id: 1})
---- ok
-STATEMENT MATCH (a:N), (b:N) WHERE a.id = 0 AND b.id = 1 CREATE (a)-[:E]->(b)
---- ok
-STATEMENT BEGIN TRANSACTION
---- ok
-STATEMENT MATCH (:N)-[edge:E]->(:N) DELETE edge
---- ok
-STATEMENT CALL topological_levels(['N'], ['E']) YIELD node, level RETURN node.id, level ORDER BY node.id
-CHECK_ORDER
---- 2
0|0
1|0
-STATEMENT ROLLBACK
---- ok
-STATEMENT CALL topological_levels(['N'], ['E']) YIELD node, level RETURN node.id, level ORDER BY node.id
-CHECK_ORDER
---- 2
0|0
1|1
-STATEMENT BEGIN TRANSACTION
---- ok
-STATEMENT MATCH (n:N) WHERE n.id = 1 DETACH DELETE n
---- ok
-STATEMENT CALL topological_levels(['N'], ['E']) YIELD node, level RETURN node.id, level
---- 1
0|0
-STATEMENT ROLLBACK
---- ok

-CASE ArgumentValidation
-STATEMENT CREATE NODE TABLE N(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE NODE TABLE M(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE REL TABLE E(FROM N TO M)
---- ok
-STATEMENT CALL topological_levels(['N']) YIELD node, level RETURN node
---- error
Binder exception: Function topological_levels did not receive correct arguments:
Actual:   (1 arguments)
Expected: (LIST<STRING>,LIST<STRING>)
-STATEMENT CALL topological_levels('N', ['E']) YIELD node, level RETURN node
---- error
Binder exception: Argument 1 of topological_levels must be LIST<STRING>, but STRING was provided.
-STATEMENT CALL topological_levels([1], ['E']) YIELD node, level RETURN node
---- error
Binder exception: Element 1 of argument 1 to topological_levels must be STRING, but INT64 was provided.
-STATEMENT CALL topological_levels(['N','N'], []) YIELD node, level RETURN node
---- error
Binder exception: Duplicate node table in graph selection: N.
-STATEMENT CALL topological_levels(['N','M'], ['E','E']) YIELD node, level RETURN node
---- error
Binder exception: Duplicate relationship table in graph selection: E.
-STATEMENT CALL topological_levels(['Missing'], []) YIELD node, level RETURN node
---- error
Binder exception: Node table Missing does not exist.
-STATEMENT CALL topological_levels(['N','M'], ['Missing']) YIELD node, level RETURN node
---- error
Binder exception: Relationship table Missing does not exist.
-STATEMENT CALL topological_levels(['N'], ['E']) YIELD node, level RETURN node
---- error
Binder exception: Relationship table E references node table M, which is not in the graph selection.
