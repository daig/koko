-DATASET CSV empty
--
-CASE Accessors
-STATEMENT CREATE NODE TABLE Person(name STRING, PRIMARY KEY(name))
---- ok
-STATEMENT CREATE NODE TABLE City(name STRING, PRIMARY KEY(name))
---- ok
-STATEMENT CREATE REL TABLE Knows(FROM Person TO Person)
---- ok
-STATEMENT CREATE (:Person {name: 'Alice'})
---- ok
-STATEMENT CREATE (:Person {name: 'Bob'})
---- ok
-STATEMENT CREATE (:City {name: 'Paris'})
---- ok
-STATEMENT MATCH (a:Person),(b:Person) WHERE a.name='Alice' AND b.name='Bob' CREATE (a)-[:Knows]->(b)
---- ok
-STATEMENT MATCH (a:Person)-[e:Knows]->(b:Person) RETURN label(a), label(e), id(a), id(e)
---- 1
Person|Knows|0:0|2:0
-STATEMENT MATCH (n) RETURN label(n), n.name ORDER BY n.name
---- 3
City|Paris
Person|Alice
Person|Bob
-STATEMENT MATCH (n:Person) WHERE label(n) = 'Person' RETURN COUNT(*)
---- 1
2
-STATEMENT MATCH (n:City) RETURN labels(n)
---- 1
City
