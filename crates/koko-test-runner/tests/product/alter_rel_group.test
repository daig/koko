# ALTER TABLE ADD/DROP FROM..TO relationship-group endpoint pairs.
-DATASET CSV empty

--

-CASE AddDropFromToMessages
-STATEMENT CREATE NODE TABLE User(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE NODE TABLE Celebrity(name STRING, PRIMARY KEY(name))
---- ok
-STATEMENT CREATE REL TABLE Follows(FROM User TO User)
---- ok
-STATEMENT ALTER TABLE Follows ADD FROM User TO Celebrity
---- 1
User->Celebrity added to table Follows.
-STATEMENT ALTER TABLE Follows ADD FROM User TO Celebrity
---- error
Binder exception: User->Celebrity already exists in Follows table.
-STATEMENT ALTER TABLE Follows ADD IF NOT EXISTS FROM User TO Celebrity
---- 1
User->Celebrity already exists in Follows table.
-STATEMENT ALTER TABLE Follows ADD FROM User TO Ghost
---- error
Binder exception: Table Ghost does not exist.
-STATEMENT ALTER TABLE Follows DROP FROM User TO Celebrity
---- 1
User->Celebrity has been dropped from table Follows.
-STATEMENT ALTER TABLE Follows DROP FROM User TO Celebrity
---- error
Binder exception: User->Celebrity does not exist in Follows table.
-STATEMENT ALTER TABLE Follows DROP IF EXISTS FROM User TO Celebrity
---- 1
User->Celebrity does not exist in Follows table.

-CASE NotARelTable
-STATEMENT CREATE NODE TABLE Person(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT ALTER TABLE Person ADD FROM Person TO Person
---- error
Binder exception: Table Person is not a relationship table.

-CASE PairGatesRelCreation
-STATEMENT CREATE NODE TABLE User(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE NODE TABLE Celebrity(name STRING, PRIMARY KEY(name))
---- ok
-STATEMENT CREATE REL TABLE Follows(FROM User TO User)
---- ok
-STATEMENT CREATE (:User {id: 1})
---- ok
-STATEMENT CREATE (:Celebrity {name: 'Ada'})
---- ok
-STATEMENT MATCH (u:User), (c:Celebrity) CREATE (u)-[:Follows]->(c)
---- error
Binder exception: Query node c violates schema. Expected labels are User.
-STATEMENT ALTER TABLE Follows ADD FROM User TO Celebrity
---- 1
User->Celebrity added to table Follows.
-STATEMENT MATCH (u:User), (c:Celebrity) CREATE (u)-[:Follows]->(c)
---- ok
-STATEMENT MATCH (u:User)-[:Follows]->(c:Celebrity) RETURN u.id, c.name
---- 1
1|Ada
-STATEMENT ALTER TABLE Follows DROP FROM User TO Celebrity
---- 1
User->Celebrity has been dropped from table Follows.
-STATEMENT MATCH (u:User), (c:Celebrity) CREATE (u)-[:Follows]->(c)
---- error
Binder exception: Query node c violates schema. Expected labels are User.
