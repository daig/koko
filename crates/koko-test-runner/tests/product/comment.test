# COMMENT ON TABLE behavior surfaced through SHOW_TABLES.
-DATASET CSV empty

--

-CASE CommentOnNodeAndRel
-STATEMENT CREATE NODE TABLE Person(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE NODE TABLE City(name STRING, PRIMARY KEY(name))
---- ok
-STATEMENT CREATE REL TABLE LivesIn(FROM Person TO City)
---- ok
-STATEMENT COMMENT ON TABLE Person IS 'A test comment'
---- 1
Comment added to table Person.
-STATEMENT COMMENT ON TABLE LivesIn IS 'rel comment'
---- 1
Comment added to table LivesIn.
-STATEMENT CALL SHOW_TABLES() RETURN *
---- 3
0|Person|NODE|main(graph)|A test comment
1|City|NODE|main(graph)|
3|LivesIn|REL|main(graph)|rel comment

-CASE CommentOverwrite
-STATEMENT CREATE NODE TABLE T(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT COMMENT ON TABLE T IS 'first'
---- 1
Comment added to table T.
-STATEMENT COMMENT ON TABLE T IS 'second'
---- 1
Comment added to table T.
-STATEMENT CALL SHOW_TABLES() RETURN *
---- 1
0|T|NODE|main(graph)|second

-CASE CommentMissingTable
-STATEMENT COMMENT ON TABLE Ghost IS 'x'
---- error
Binder exception: Table Ghost does not exist.

# In-query `CALL SHOW_TABLES() WHERE name = '…' RETURN comment` filters + projects
# the comment column.
-CASE ShowTablesWhereReturnComment
-STATEMENT CREATE NODE TABLE Person(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE NODE TABLE City(name STRING, PRIMARY KEY(name))
---- ok
-STATEMENT COMMENT ON TABLE Person IS 'people table'
---- 1
Comment added to table Person.
-STATEMENT CALL SHOW_TABLES() WHERE name = 'Person' RETURN comment
---- 1
people table
-STATEMENT CALL SHOW_TABLES() WHERE name = 'City' RETURN comment
---- 1

