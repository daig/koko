-DATASET CSV empty
--

# A relationship table may declare multiple FROM-TO node-table pairs
# (CREATE REL TABLE R(FROM A TO B, FROM C TO D, …)). A pattern over it connects
# if ANY pair connects the endpoints (H2b machinery), and CREATE accepts an edge
# whose endpoints match any declared pair.

-CASE MultiPairRelTable
-STATEMENT CREATE NODE TABLE Person(name STRING, PRIMARY KEY(name))
---- ok
-STATEMENT CREATE NODE TABLE City(name STRING, PRIMARY KEY(name))
---- ok
-STATEMENT CREATE REL TABLE Likes(FROM Person TO Person, FROM Person TO City, n INT64)
---- ok
-STATEMENT CREATE (:Person {name: 'Alice'})
---- ok
-STATEMENT CREATE (:Person {name: 'Bob'})
---- ok
-STATEMENT CREATE (:City {name: 'Paris'})
---- ok
-STATEMENT MATCH (a:Person),(b:Person) WHERE a.name='Alice' AND b.name='Bob' CREATE (a)-[:Likes {n:1}]->(b)
---- ok
-STATEMENT MATCH (a:Person),(c:City) WHERE a.name='Alice' CREATE (a)-[:Likes {n:2}]->(c)
---- ok
-STATEMENT MATCH (a:Person)-[:Likes]->(b) RETURN COUNT(*)
---- 1
2
-STATEMENT MATCH (a:Person)-[:Likes]->(b:City) RETURN COUNT(*)
---- 1
1
-STATEMENT MATCH (a:Person)-[:Likes]->(b:Person) RETURN COUNT(*)
---- 1
1
