          (FLOAT) -> DOUBLE

-CASE CreateTypeMismatchRejected
-STATEMENT CREATE NODE TABLE P(id INT64, v INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE (:P {id: 1, v: 2.5})
---- ok
-STATEMENT MATCH (n:P {id: 1}) RETURN n.v
---- 1
2
-STATEMENT CREATE (:P {id: 2, v: 'oops'})
---- error
Conversion exception: Cast failed. Could not convert "oops" to INT64.

-CASE IntToDoubleWideningAllowed
-STATEMENT CREATE NODE TABLE P(id INT64, score DOUBLE, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE (:P {id: 1, score: 5})
---- ok
-STATEMENT MATCH (p:P) RETURN p.score
---- 1
5.000000

-CASE SignedZeroGroupsAsOne
-STATEMENT CREATE NODE TABLE P(id INT64, v DOUBLE, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE (:P {id: 1, v: 0.0})
---- ok
-STATEMENT CREATE (:P {id: 2, v: -0.0})
---- ok
-STATEMENT MATCH (p:P) RETURN p.v, count(*)
---- 1
0.000000|2
