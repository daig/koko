          (INT64) -> DOUBLE
          DISTINCT (INT32) -> DOUBLE
          (INT32) -> DOUBLE
          DISTINCT (INT16) -> DOUBLE
          (INT16) -> DOUBLE
          DISTINCT (INT8) -> DOUBLE
          (INT8) -> DOUBLE
          DISTINCT (SERIAL) -> DOUBLE
          (SERIAL) -> DOUBLE
          DISTINCT (UINT128) -> DOUBLE
          (UINT128) -> DOUBLE
          DISTINCT (UINT64) -> DOUBLE
          (UINT64) -> DOUBLE
          DISTINCT (UINT32) -> DOUBLE
          (UINT32) -> DOUBLE
          DISTINCT (UINT16) -> DOUBLE
          (UINT16) -> DOUBLE
          DISTINCT (UINT8) -> DOUBLE
          (UINT8) -> DOUBLE
          DISTINCT (DOUBLE) -> DOUBLE
          (DOUBLE) -> DOUBLE
