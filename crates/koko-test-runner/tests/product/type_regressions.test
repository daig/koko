-DATASET CSV empty

--

-CASE SumInt64WidensToInt128
-STATEMENT CREATE NODE TABLE T(id INT64, v INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE (:T {id: 1, v: 9223372036854775807})
---- ok
-STATEMENT CREATE (:T {id: 2, v: 9223372036854775807})
---- ok
# SUM widens to INT128 so two i64::MAX values sum exactly.
-STATEMENT MATCH (t:T) RETURN sum(t.v)
---- 1
18446744073709551614

-CASE SumOverNonNumericRejected
-STATEMENT CREATE NODE TABLE P(name STRING, PRIMARY KEY(name))
---- ok
-STATEMENT CREATE (:P {name: 'a'})
---- ok
-STATEMENT MATCH (p:P) RETURN sum(p.name)
---- error
Binder exception: Function SUM did not receive correct arguments:
Actual:   (STRING)
Expected: DISTINCT (INT128) -> INT128
          (INT128) -> INT128
          DISTINCT (INT64) -> INT128
          (INT64) -> INT128
          DISTINCT (INT32) -> INT128
          (INT32) -> INT128
          DISTINCT (INT16) -> INT128
          (INT16) -> INT128
          DISTINCT (INT8) -> INT128
          (INT8) -> INT128
          DISTINCT (SERIAL) -> INT128
          (SERIAL) -> INT128
          DISTINCT (UINT128) -> UINT128
          (UINT128) -> UINT128
          DISTINCT (UINT64) -> UINT128
          (UINT64) -> UINT128
          DISTINCT (UINT32) -> UINT128
          (UINT32) -> UINT128
          DISTINCT (UINT16) -> UINT128
          (UINT16) -> UINT128
          DISTINCT (UINT8) -> UINT128
          (UINT8) -> UINT128
          DISTINCT (DOUBLE) -> DOUBLE
          (DOUBLE) -> DOUBLE
          DISTINCT (FLOAT) -> DOUBLE
          (FLOAT) -> DOUBLE

