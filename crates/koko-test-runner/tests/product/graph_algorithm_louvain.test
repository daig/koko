# Deterministic serial Louvain uses statement-bound selected tables, unweighted undirected
# multiplicity, Ladybug local-move/aggregation limits, and canonical compact communities.
-DATASET CSV empty

--

-CASE EmptySingletonDefaultsAndCatalog
-STATEMENT CREATE NODE TABLE N(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE REL TABLE E(FROM N TO N)
---- ok
-STATEMENT CREATE (:N {id: 0}), (:N {id: 1})
---- ok
-STATEMENT MATCH (n:N) WHERE n.id = 0 CREATE (n)-[:E]->(n)
---- ok
-STATEMENT CALL louvain([], []) YIELD node, community_id RETURN count(*)
---- 1
0
-STATEMENT CALL louvain(['N'], ['E']) YIELD node, community_id RETURN node.id, community_id ORDER BY node.id
-CHECK_ORDER
---- 2
0|0
1|1
-STATEMENT CALL show_functions() WHERE name = 'LOUVAIN' RETURN type, signature ORDER BY signature
-CHECK_ORDER
---- 2
ALGORITHM FUNCTION|(LIST<STRING>,LIST<STRING>) -> TABLE(node NODE, community_id INT64)
ALGORITHM FUNCTION|(LIST<STRING>,LIST<STRING>,INT64,INT64) -> TABLE(node NODE, community_id INT64)

-CASE DisconnectedCliquesAndBridge
-STATEMENT CREATE NODE TABLE N(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE REL TABLE E(FROM N TO N)
---- ok
-STATEMENT UNWIND range(0, 5) AS id CREATE (:N {id: id})
---- ok
-STATEMENT MATCH (a:N), (b:N) WHERE (a.id = 0 AND b.id = 1) OR (a.id = 0 AND b.id = 2) OR (a.id = 1 AND b.id = 2) OR (a.id = 3 AND b.id = 4) OR (a.id = 3 AND b.id = 5) OR (a.id = 4 AND b.id = 5) OR (a.id = 2 AND b.id = 3) CREATE (a)-[:E]->(b)
---- ok
-STATEMENT CALL louvain(['N'], ['E']) YIELD community_id AS cid, node AS member WHERE cid >= 0 RETURN member.id, cid ORDER BY member.id
-CHECK_ORDER
---- 6
0|0
1|0
2|0
3|1
4|1
5|1
-STATEMENT CALL louvain(['N'], ['E']) YIELD community_id RETURN community_id, count(*) ORDER BY community_id
-CHECK_ORDER
---- 2
0|3
1|3

-CASE SelfLoopsAndParallelRelationships
-STATEMENT CREATE NODE TABLE N(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE REL TABLE E(FROM N TO N)
---- ok
-STATEMENT UNWIND range(0, 3) AS id CREATE (:N {id: id})
---- ok
-STATEMENT MATCH (a:N), (b:N) WHERE a.id = 0 AND b.id = 1 CREATE (a)-[:E]->(b), (a)-[:E]->(b), (a)-[:E]->(b)
---- ok
-STATEMENT MATCH (a:N), (b:N) WHERE a.id = 2 AND b.id = 3 CREATE (a)-[:E]->(b), (a)-[:E]->(b), (a)-[:E]->(b)
---- ok
-STATEMENT MATCH (a:N), (b:N) WHERE a.id = 1 AND b.id = 2 CREATE (a)-[:E]->(b)
---- ok
-STATEMENT MATCH (a:N) WHERE a.id = 0 OR a.id = 3 CREATE (a)-[:E]->(a)
---- ok
-STATEMENT CALL louvain(['N'], ['E']) YIELD node, community_id RETURN node.id, community_id ORDER BY node.id
-CHECK_ORDER
---- 4
0|0
1|0
2|1
3|1

-CASE DeterministicTiesAndConfiguredLimits
-STATEMENT CREATE NODE TABLE N(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE REL TABLE E(FROM N TO N)
---- ok
-STATEMENT UNWIND range(0, 3) AS id CREATE (:N {id: id})
---- ok
-STATEMENT MATCH (a:N), (b:N) WHERE (a.id = 0 AND b.id = 1) OR (a.id = 1 AND b.id = 2) OR (a.id = 2 AND b.id = 3) CREATE (a)-[:E]->(b)
---- ok
-STATEMENT CALL louvain(['N'], ['E']) YIELD node, community_id RETURN node.id, community_id ORDER BY node.id
-CHECK_ORDER
---- 4
0|0
1|0
2|1
3|1
-STATEMENT CALL louvain(['N'], ['E'], 2, 1) YIELD node, community_id RETURN node.id, community_id ORDER BY node.id
-CHECK_ORDER
---- 4
0|0
1|0
2|1
3|1
-STATEMENT CALL louvain(['N'], ['E'], 0, 20) YIELD node, community_id RETURN node.id, community_id ORDER BY node.id
-CHECK_ORDER
---- 4
0|0
1|1
2|2
3|3
-STATEMENT CALL louvain(['N'], ['E'], 20, 0) YIELD node, community_id RETURN node.id, community_id ORDER BY node.id
-CHECK_ORDER
---- 4
0|0
1|1
2|2
3|3

-CASE MultiTableInputAndCallerOrder
-STATEMENT CREATE NODE TABLE A(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE NODE TABLE B(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE REL TABLE Link(FROM A TO B)
---- ok
-STATEMENT CREATE (:A {id: 0}), (:A {id: 1}), (:B {id: 10}), (:B {id: 11})
---- ok
-STATEMENT MATCH (a:A), (b:B) WHERE (a.id = 0 AND b.id = 10) OR (a.id = 1 AND b.id = 11) CREATE (a)-[:Link]->(b)
---- ok
-STATEMENT CALL louvain(['B','A'], ['Link']) YIELD community_id AS cid, node RETURN label(node), node.id, cid
-CHECK_ORDER
---- 4
B|10|0
B|11|1
A|0|0
A|1|1

-CASE PipelineComposition
-STATEMENT CREATE NODE TABLE N(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE REL TABLE E(FROM N TO N)
---- ok
-STATEMENT CREATE (:N {id: 0}), (:N {id: 1})
---- ok
-STATEMENT MATCH (a:N), (b:N) WHERE a.id = 0 AND b.id = 1 CREATE (a)-[:E]->(b)
---- ok
-STATEMENT UNWIND [10,20] AS outer CALL louvain(['N'], ['E']) YIELD community_id, node RETURN outer, node.id, community_id ORDER BY outer, node.id
-CHECK_ORDER
---- 4
10|0|0
10|1|0
20|0|0
20|1|0

-CASE TransactionVisibility
-STATEMENT CREATE NODE TABLE N(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE REL TABLE E(FROM N TO N)
---- ok
-STATEMENT CREATE (:N {id: 0}), (:N {id: 1})
---- ok
-STATEMENT BEGIN TRANSACTION
---- ok
-STATEMENT MATCH (a:N), (b:N) WHERE a.id = 0 AND b.id = 1 CREATE (a)-[:E]->(b)
---- ok
-STATEMENT CALL louvain(['N'], ['E']) YIELD node, community_id RETURN node.id, community_id ORDER BY node.id
-CHECK_ORDER
---- 2
0|0
1|0
-STATEMENT ROLLBACK
---- ok
-STATEMENT CALL louvain(['N'], ['E']) YIELD node, community_id RETURN node.id, community_id ORDER BY node.id
-CHECK_ORDER
---- 2
0|0
1|1
-STATEMENT MATCH (a:N), (b:N) WHERE a.id = 0 AND b.id = 1 CREATE (a)-[:E]->(b)
---- ok
-STATEMENT BEGIN TRANSACTION
---- ok
-STATEMENT MATCH (n:N) WHERE n.id = 1 DETACH DELETE n
---- ok
-STATEMENT CALL louvain(['N'], ['E']) YIELD node, community_id RETURN node.id, community_id
---- 1
0|0
-STATEMENT ROLLBACK
---- ok
-STATEMENT CALL louvain(['N'], ['E']) YIELD node, community_id RETURN node.id, community_id ORDER BY node.id
-CHECK_ORDER
---- 2
0|0
1|0

-CASE ArgumentValidation
-STATEMENT CREATE NODE TABLE N(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE REL TABLE E(FROM N TO N)
---- ok
-STATEMENT CALL louvain(['N'], ['E'], 20) YIELD node, community_id RETURN node
---- error
Binder exception: Function louvain did not receive correct arguments:
Actual:   (3 arguments)
Expected: (LIST<STRING>,LIST<STRING>) or (LIST<STRING>,LIST<STRING>,INT64,INT64)
-STATEMENT CALL louvain(['N'], ['E'], -1, 20) YIELD node, community_id RETURN node
---- error
Binder exception: Argument 3 (max_iterations) of louvain must be nonnegative.
-STATEMENT CALL louvain(['N'], ['E'], 20, -1) YIELD node, community_id RETURN node
---- error
Binder exception: Argument 4 (max_phases) of louvain must be nonnegative.
-STATEMENT CALL louvain(['N'], ['E'], '20', 20) YIELD node, community_id RETURN node
---- error
Binder exception: Argument 3 (max_iterations) of louvain must be INT64, but STRING was provided.
