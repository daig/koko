# Koko list comprehensions reserve `[var IN ...]`; parenthesize a membership
# expression when it is intended as a list-literal element.
-DATASET CSV empty

--

-CASE FilterAndProject
-STATEMENT RETURN [x IN [1,2,3,4,5] WHERE x > 2 | x * 10]
---- 1
[30,40,50]

-CASE OptionalFilterAndProjection
-STATEMENT RETURN [x IN [1,2,3] | x + 1], [x IN [1,NULL,3] WHERE x > 0], [x IN [1,2,3]]
---- 1
[2,3,4]|[1,3]|[1,2,3]
-STATEMENT RETURN [x IN NULL WHERE true | x] IS NULL
---- 1
True

-CASE OuterCaptureAndNestedShadowing
-STATEMENT UNWIND [10,20] AS base RETURN base, [x IN [1,2,3] WHERE x < 3 | x + base] ORDER BY base
-CHECK_ORDER
---- 2
10|[11,12]
20|[21,22]
-STATEMENT RETURN [x IN [1,2] | [x IN [x,x+1] WHERE x > 1 | x * 10]]
---- 1
[[20],[20,30]]

-CASE ScopeAndValidation
-STATEMENT UNWIND [1] AS x RETURN [(x IN [1,2])]
---- 1
[True]
-STATEMENT RETURN [x IN [1,2] WHERE x | x]
---- error
Binder exception: LIST_FILTER requires the result type of lambda expression be BOOL.
-STATEMENT RETURN [x IN [1,2] WHERE x > 0 | x], x
---- error
Binder exception: Variable x is not in scope.
