-DATASET CSV tinysnb
--
-CASE Exists
-STATEMENT MATCH (a:person) WHERE EXISTS { MATCH (a)-[:knows]->(b:person) } RETURN COUNT(*)
---- 1
5
-STATEMENT MATCH (a:person) WHERE NOT EXISTS { MATCH (a)-[:knows]->(b:person) } RETURN COUNT(*)
---- 1
3
# A WHERE inside the subquery filters the matches.
-STATEMENT MATCH (a:person) WHERE EXISTS { MATCH (a)-[:knows]->(b:person) WHERE b.fName='Farooq' } RETURN COUNT(*)
---- 1
1
# A subquery combined with an ordinary predicate (OR).
-STATEMENT MATCH (a:person)-[:knows]->(b:person) WHERE EXISTS { MATCH (a)-[:studyAt]->(c:organisation) } OR b.fName='Greg'  RETURN COUNT(*)
---- 1
7
# Multi-element subquery pattern (two chains from a).
-STATEMENT MATCH (a:person) WHERE EXISTS { MATCH (a)-[:knows]->(b:person)-[:knows]->(c:person), (a)-[:knows]->(d:person) } RETURN COUNT(*)
---- 1
4
# Cyclic subquery pattern.
-STATEMENT MATCH (a:person) WHERE EXISTS { MATCH (a)-[:knows]->(b:person), (b)-[:knows]->(a) } RETURN COUNT(*)
---- 1
4
# Two independent subqueries combined with OR.
-STATEMENT MATCH (a:person) WHERE EXISTS { MATCH (a)-[:studyAt]->(b:organisation) } OR EXISTS { MATCH (a)-[:workAt]->(c:organisation) } RETURN COUNT(*)
---- 1
6

-CASE Count
# A per-row COUNT subquery in RETURN (out-degree).
-STATEMENT MATCH (a:person) RETURN a.fName, COUNT { MATCH (a)-[:knows]->(b:person) }
---- 8
Alice|3
Bob|3
Carol|3
Dan|3
Elizabeth|2
Farooq|0
Greg|0
Hubert Blaine Wolfeschlegelsteinhausenbergerdorff|0
# A COUNT subquery in WHERE.
-STATEMENT MATCH (a:person) WHERE COUNT { MATCH (a)-[:studyAt]->(b:organisation)} = 1 RETURN a.fName
---- 3
Alice
Bob
Farooq
# A correlated WHERE inside the COUNT subquery (count people older than a).
-STATEMENT MATCH (a:person) RETURN a.age, COUNT { MATCH (b:person) WHERE a.age < b.age }
---- 8
20|6
20|6
25|5
30|4
35|3
40|2
45|1
83|0
