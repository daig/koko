-DATASET CSV empty

--

-CASE UnlabeledHintBindsWithoutPanic
-STATEMENT CREATE NODE TABLE Device(id STRING, PRIMARY KEY(id));
---- ok
-STATEMENT CREATE NODE TABLE Execution(id STRING, PRIMARY KEY(id));
---- ok
-STATEMENT CREATE NODE TABLE Request(id STRING, PRIMARY KEY(id));
---- ok
-STATEMENT CREATE REL TABLE REQUESTED_BY(FROM Execution TO Request);
---- ok
-STATEMENT CREATE REL TABLE TARGET(FROM Request TO Device);
---- ok
-STATEMENT CREATE (:Execution { id: 'E1' })-[:REQUESTED_BY]->(:Request { id: 'R1' })-[:TARGET]->(:Device { id: 'D1' });
---- ok
-STATEMENT MATCH (execution:Execution { id: 'E1' }) CREATE (execution)-[:REQUESTED_BY]->(r:Request { id: 'R2' })-[:TARGET]->(d:Device { id: 'D2' }) RETURN execution.id, r.id, d.id;
---- ok
-STATEMENT MATCH (request:Request { id: 'R1' }) DETACH DELETE request;
---- ok
-STATEMENT MATCH (execution:Execution { id: 'E1' }) DETACH DELETE execution;
---- ok
-STATEMENT MATCH ()-[r]->() RETURN COUNT(*)
---- 1
1
-STATEMENT MATCH (a)-[r]->(b) HINT a JOIN (r JOIN b) RETURN a.id, b.id;
---- 1
R2|D2

-CASE PolymorphicWithRuntimeTableMapping
-STATEMENT CREATE NODE TABLE Comment(id INT64, creationDate INT64, content STRING, PRIMARY KEY(id));
---- ok
-STATEMENT CREATE NODE TABLE Post(id INT64, content STRING, creationDate INT64, PRIMARY KEY(id));
---- ok
-STATEMENT CREATE (:Post {id: 1, content: 'x', creationDate: 10});
---- ok
-STATEMENT MATCH (m:Comment:Post) WITH m, m.creationDate AS cd RETURN cd
---- 1
10
