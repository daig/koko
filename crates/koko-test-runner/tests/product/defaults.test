# Constant, computed, and nextval defaults on CREATE and ALTER ADD.
-DATASET CSV empty

--

-CASE LiteralDefaultOnCreate
-STATEMENT CREATE NODE TABLE books(ID INT64, rating DOUBLE DEFAULT 0, PRIMARY KEY(ID))
---- ok
-STATEMENT CREATE (:books {ID: 0})
---- ok
-STATEMENT MATCH (b:books) RETURN b.*
---- 1
0|0.000000
-STATEMENT CREATE (:books {ID: 1, rating: 4.5})
---- ok
-STATEMENT MATCH (b:books) WHERE b.ID = 1 RETURN b.rating
---- 1
4.500000

-CASE ComputedDefaults
-STATEMENT CREATE NODE TABLE T(id INT64, a INT64 DEFAULT 5 + 5, b INT64 DEFAULT 2 * abs(-2), PRIMARY KEY(id))
---- ok
-STATEMENT CREATE (:T {id: 0})
---- ok
-STATEMENT MATCH (t:T) RETURN t.a, t.b
---- 1
10|4

-CASE StringAndListDefaults
-STATEMENT CREATE NODE TABLE T(id INT64, s STRING DEFAULT 'hi', xs INT64[] DEFAULT [1, 2, 3], PRIMARY KEY(id))
---- ok
-STATEMENT CREATE (:T {id: 0})
---- ok
-STATEMENT MATCH (t:T) RETURN t.s, t.xs
---- 1
hi|[1,2,3]

-CASE NextvalDefaultOnCreate
-STATEMENT CREATE SEQUENCE test
---- ok
-STATEMENT CREATE NODE TABLE test(id INT64, seq INT64 DEFAULT nextval('test'), PRIMARY KEY(id))
---- ok
-STATEMENT CREATE (:test {id: 0})
---- ok
-STATEMENT MATCH (t:test) RETURN t.*
---- 1
0|1
-STATEMENT CREATE (:test {id: 1})
---- ok
-STATEMENT MATCH (t:test) WHERE t.id = 1 RETURN t.seq
---- 1
2

-CASE NextvalDefaultAsPrimaryKey
-STATEMENT CREATE SEQUENCE test
---- ok
-STATEMENT CREATE NODE TABLE test(id INT64 DEFAULT nextval('test'), PRIMARY KEY(id))
---- ok
-STATEMENT CREATE (:test)
---- ok
-STATEMENT CREATE (:test)
---- ok
-STATEMENT MATCH (t:test) RETURN t.id ORDER BY t.id
---- 2
1
2

-CASE CycleSequenceOnInsert
-STATEMENT CREATE SEQUENCE test START 1 MAXVALUE 3
---- ok
-STATEMENT CREATE NODE TABLE test(id INT64 DEFAULT nextval('test'), PRIMARY KEY(id))
---- ok
-STATEMENT CREATE (:test)
---- ok
-STATEMENT CREATE (:test)
---- ok
-STATEMENT CREATE (:test)
---- ok
-STATEMENT CREATE (:test)
---- error
Catalog exception: nextval: reached maximum value of sequence "test" 3

-CASE SharedSequenceAcrossTables
-STATEMENT CREATE SEQUENCE shared
---- ok
-STATEMENT CREATE NODE TABLE tba(id INT64, seq INT64 DEFAULT nextval('shared'), PRIMARY KEY(id))
---- ok
-STATEMENT CREATE NODE TABLE tbb(id INT64 DEFAULT nextval('shared'), PRIMARY KEY(id))
---- ok
-STATEMENT CREATE (:tba {id: 0})
---- ok
-STATEMENT CREATE (:tbb)
---- ok
-STATEMENT MATCH (t:tba) RETURN t.*
---- 1
0|1
-STATEMENT MATCH (t:tbb) RETURN t.*
---- 1
2

-CASE SerialWithDefaultErrors
-STATEMENT CREATE NODE TABLE T(id SERIAL DEFAULT 5, name STRING, PRIMARY KEY(id))
---- error
Binder exception: No DEFAULT value should be set for SERIAL columns

-CASE AlterAddComputedDefaultBackfill
-STATEMENT CREATE NODE TABLE P(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE (:P {id: 0})
---- ok
-STATEMENT CREATE (:P {id: 1})
---- ok
-STATEMENT ALTER TABLE P ADD score INT64 DEFAULT 3 * 4
---- 1
Property score added to table P.
-STATEMENT MATCH (p:P) RETURN DISTINCT p.score
---- 1
12

-CASE AlterAddNextvalDefaultBackfill
-STATEMENT CREATE SEQUENCE s
---- ok
-STATEMENT CREATE NODE TABLE P(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE (:P {id: 10})
---- ok
-STATEMENT CREATE (:P {id: 20})
---- ok
-STATEMENT ALTER TABLE P ADD n INT64 DEFAULT nextval('s')
---- 1
Property n added to table P.
-STATEMENT MATCH (p:P) RETURN p.id, p.n ORDER BY p.id
---- 2
10|1
20|2
-STATEMENT CREATE (:P {id: 30})
---- ok
-STATEMENT MATCH (p:P) WHERE p.id = 30 RETURN p.n
---- 1
3

-CASE AlterAddNextvalOnRelTableErrors
-STATEMENT CREATE NODE TABLE A(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE REL TABLE R(FROM A TO A)
---- ok
-STATEMENT CREATE SEQUENCE s
---- ok
-STATEMENT ALTER TABLE R ADD w INT64 DEFAULT nextval('s')
---- error
Runtime exception: Cannot set a non-constant default value when adding columns on REL tables.
