-DATASET CSV empty
--
# WITH carries scalar values and aggregates across query parts over explicit setup data.

-CASE WithSetup
-STATEMENT CREATE NODE TABLE Person(name STRING, age INT64, team STRING, PRIMARY KEY(name))
---- ok
-STATEMENT CREATE (:Person {name:'Alice', age:35, team:'red'})
---- ok
-STATEMENT CREATE (:Person {name:'Bob', age:30, team:'red'})
---- ok
-STATEMENT CREATE (:Person {name:'Carol', age:45, team:'blue'})
---- ok
-STATEMENT CREATE (:Person {name:'Dan', age:30, team:'blue'})
---- ok
# A WITH-WHERE filters the projected scalar (post-projection, like HAVING).
-STATEMENT MATCH (p:Person) WITH p.age AS age WHERE age > 30 RETURN age
---- 2
35
45
# Global aggregate carried forward then returned.
-STATEMENT MATCH (p:Person) WITH count(*) AS c, avg(p.age) AS a RETURN c, a
---- 1
4|35.000000
# Grouped aggregate: the non-aggregate item is the grouping key.
-STATEMENT MATCH (p:Person) WITH p.team AS team, count(*) AS c RETURN team, c
---- 2
blue|2
red|2
# WITH-WHERE over an aggregate result (HAVING).
-STATEMENT MATCH (p:Person) WITH p.team AS team, sum(p.age) AS s WHERE s > 70 RETURN team, s
---- 1
blue|75
# DISTINCT in WITH deduplicates the carried scalar.
-STATEMENT MATCH (p:Person) WITH DISTINCT p.age AS age RETURN age
---- 3
30
35
45
# Chained WITH: aggregate over a prior aggregate's groups.
-STATEMENT MATCH (p:Person) WITH p.team AS team, count(*) AS c WITH sum(c) AS total RETURN total
---- 1
4
# collect(scalar) then UNWIND back out, then a WITH-WHERE, then count — 3 parts.
-STATEMENT MATCH (p:Person) WITH collect(p.age) AS ages UNWIND ages AS age WITH age WHERE age = 30 RETURN count(*)
---- 1
2
# A fresh MATCH after WITH, correlated to carried scalars only via WHERE.
-STATEMENT MATCH (p:Person) WITH p.age AS a, p.name AS n MATCH (q:Person) WHERE q.age = a AND q.name <> n RETURN n, q.name
---- 2
Bob|Dan
Dan|Bob
# WITH * carries every in-scope variable forward.
-STATEMENT UNWIND [1,2,3] AS x WITH * RETURN x
---- 3
1
2
3
# A global aggregate over zero rows still carries exactly one row forward.
-STATEMENT MATCH (p:Person) WHERE p.age > 1000 WITH count(*) AS c RETURN c
---- 1
0

-CASE WithOrderingAfterLimit
# WITH-WHERE runs after ORDER BY / SKIP / LIMIT: order 1..5, retain the first
# three, then filter values greater than one to produce {2,3}.
-STATEMENT UNWIND [5,1,3,2,4] AS x WITH x ORDER BY x LIMIT 3 WHERE x > 1 RETURN x
-CHECK_ORDER
---- 2
2
3
# ORDER BY DESC + SKIP + LIMIT in a WITH.
-STATEMENT UNWIND [3,1,2] AS x WITH x AS x ORDER BY x DESC LIMIT 2 RETURN x
-CHECK_ORDER
---- 2
3
2

-CASE WithValidations
-STATEMENT CREATE NODE TABLE Person(name STRING, age INT64, PRIMARY KEY(name))
---- ok
# A non-variable WITH item must be aliased.
-STATEMENT MATCH (p:Person) WITH p.age RETURN p.age
---- error
Binder exception: Expression in WITH must be aliased (use AS).
# ORDER BY in WITH requires SKIP or LIMIT.
-STATEMENT UNWIND [1,2,3] AS x WITH x ORDER BY x RETURN x
---- error
Binder exception: In WITH clause, ORDER BY must be followed by SKIP or LIMIT.
# WITH * with nothing in scope.
-STATEMENT WITH * RETURN 1
---- error
Binder exception: RETURN or WITH * is not allowed when there are no variables in scope.
# Duplicate output column names in WITH.
-STATEMENT UNWIND [1] AS y WITH y AS x, y AS x RETURN x
---- error
Binder exception: Multiple result columns with the same name x are not supported.

-CASE WithNodeCarry
-STATEMENT CREATE NODE TABLE Person(name STRING, age INT64, PRIMARY KEY(name))
---- ok
-STATEMENT CREATE REL TABLE Knows(FROM Person TO Person)
---- ok
-STATEMENT CREATE (:Person {name:'Alice', age:35})
---- ok
-STATEMENT CREATE (:Person {name:'Bob', age:30})
---- ok
-STATEMENT CREATE (:Person {name:'Carol', age:45})
---- ok
-STATEMENT MATCH (a:Person {name:'Alice'}), (b:Person {name:'Bob'}) CREATE (a)-[:Knows]->(b)
---- ok
-STATEMENT MATCH (a:Person {name:'Alice'}), (b:Person {name:'Carol'}) CREATE (a)-[:Knows]->(b)
---- ok
# D2b: carry a node forward, project a property of it in the next part.
-STATEMENT MATCH (p:Person) WITH p AS q RETURN q.name
---- 3
Alice
Bob
Carol
# A WITH-WHERE filtering on the carried node's property.
-STATEMENT MATCH (p:Person) WITH p WHERE p.age > 30 RETURN p.name
---- 2
Alice
Carol
# Re-extend from a carried node (the carried id seeds the extend).
-STATEMENT MATCH (a:Person) WITH a MATCH (a)-[:Knows]->(b:Person) RETURN a.name, b.name
---- 2
Alice|Bob
Alice|Carol
# Count carried nodes.
-STATEMENT MATCH (p:Person) WITH p AS q RETURN count(q)
---- 1
3
# Group by a carried node (its internal id is the group key).
-STATEMENT MATCH (a:Person)-[:Knows]->(b:Person) WITH a, count(*) AS c RETURN a.name, c
---- 1
Alice|2

-CASE WithRelCarry
-STATEMENT CREATE NODE TABLE Person(name STRING, PRIMARY KEY(name))
---- ok
-STATEMENT CREATE REL TABLE Knows(FROM Person TO Person, since INT64)
---- ok
-STATEMENT CREATE (:Person {name:'Alice'})
---- ok
-STATEMENT CREATE (:Person {name:'Bob'})
---- ok
-STATEMENT MATCH (a:Person {name:'Alice'}), (b:Person {name:'Bob'}) CREATE (a)-[:Knows {since: 2020}]->(b)
---- ok
# A relationship variable is carried through WITH as a value; its properties are
# read off that value (Wave C), and the whole value can be returned.
-STATEMENT MATCH (a:Person)-[r:Knows]->(b:Person) WITH r AS rr RETURN rr.since
---- 1
2020
-STATEMENT MATCH (a:Person)-[r:Knows]->(b:Person) WITH a, r, COUNT(*) AS c RETURN r.since, c, a.name
---- 1
2020|1|Alice
-STATEMENT MATCH (a:Person)-[r:Knows]->(b:Person) WITH r AS rr RETURN rr
---- 1
(0:0)-{_LABEL: Knows, _ID: 1:0, since: 2020}->(0:1)
