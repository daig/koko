# K-core decomposition peels the statement-visible selected graph as an undirected
# multigraph while retaining parallel-edge and self-loop degree multiplicity.
-DATASET CSV empty

--

-CASE EmptySelectionAndIsolatedVertices
-STATEMENT CREATE NODE TABLE N(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE REL TABLE E(FROM N TO N)
---- ok
-STATEMENT CREATE (:N {id: 0}), (:N {id: 1}), (:N {id: 2})
---- ok
-STATEMENT CALL k_core_decomposition([], []) YIELD node, core RETURN count(*)
---- 1
0
-STATEMENT CALL k_core_decomposition(['N'], ['E']) YIELD node, core RETURN node.id, core ORDER BY node.id
-CHECK_ORDER
---- 3
0|0
1|0
2|0
-STATEMENT CALL show_functions() WHERE name = 'K_CORE_DECOMPOSITION' RETURN type, signature
---- 1
ALGORITHM FUNCTION|(LIST<STRING>,LIST<STRING>) -> TABLE(node NODE, core INT64)

-CASE TreesCyclesAndCliques
-STATEMENT CREATE NODE TABLE N(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE REL TABLE E(FROM N TO N)
---- ok
-STATEMENT UNWIND range(0, 11) AS id CREATE (:N {id: id})
---- ok
-STATEMENT MATCH (a:N), (b:N) WHERE (a.id = 0 AND b.id = 1) OR (a.id = 1 AND b.id = 2) OR (a.id = 2 AND b.id = 3) CREATE (a)-[:E]->(b)
---- ok
-STATEMENT MATCH (a:N), (b:N) WHERE (a.id = 4 AND b.id = 5) OR (a.id = 5 AND b.id = 6) OR (a.id = 6 AND b.id = 7) OR (a.id = 7 AND b.id = 4) CREATE (a)-[:E]->(b)
---- ok
-STATEMENT MATCH (a:N), (b:N) WHERE (a.id = 8 AND b.id IN [9,10,11]) OR (a.id = 9 AND b.id IN [10,11]) OR (a.id = 10 AND b.id = 11) CREATE (a)-[:E]->(b)
---- ok
-STATEMENT CALL k_core_decomposition(['N'], ['E']) YIELD node, core RETURN node.id, core ORDER BY node.id
-CHECK_ORDER
---- 12
0|1
1|1
2|1
3|1
4|2
5|2
6|2
7|2
8|3
9|3
10|3
11|3

-CASE MixedCoreNumbers
-STATEMENT CREATE NODE TABLE N(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE REL TABLE E(FROM N TO N)
---- ok
-STATEMENT UNWIND range(0, 9) AS id CREATE (:N {id: id})
---- ok
-STATEMENT MATCH (a:N), (b:N) WHERE (a.id = 0 AND b.id = 1) OR (a.id = 1 AND b.id = 2) OR (a.id = 2 AND b.id = 3) OR (a.id = 2 AND b.id = 7) OR (a.id = 3 AND b.id IN [4,5,6]) OR (a.id = 4 AND b.id IN [5,6]) OR (a.id = 5 AND b.id = 6) OR (a.id = 6 AND b.id = 7) OR (a.id = 8 AND b.id = 9) CREATE (a)-[:E]->(b)
---- ok
-STATEMENT CALL k_core_decomposition(['N'], ['E']) YIELD node, core RETURN node.id, core ORDER BY node.id
-CHECK_ORDER
---- 10
0|1
1|1
2|2
3|3
4|3
5|3
6|3
7|2
8|1
9|1

-CASE ParallelRelationshipsAndSelfLoops
-STATEMENT CREATE NODE TABLE N(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE REL TABLE E(FROM N TO N)
---- ok
-STATEMENT UNWIND range(0, 5) AS id CREATE (:N {id: id})
---- ok
-STATEMENT MATCH (a:N), (b:N) WHERE a.id = 0 AND b.id = 1 CREATE (a)-[:E]->(b), (a)-[:E]->(b), (a)-[:E]->(b)
---- ok
-STATEMENT MATCH (n:N) WHERE n.id = 2 CREATE (n)-[:E]->(n)
---- ok
-STATEMENT MATCH (a:N), (b:N) WHERE a.id = 3 AND b.id = 4 CREATE (a)-[:E]->(a), (a)-[:E]->(b)
---- ok
-STATEMENT CALL k_core_decomposition(['N'], ['E']) YIELD node, core RETURN node.id, core ORDER BY node.id
-CHECK_ORDER
---- 6
0|3
1|3
2|2
3|2
4|1
5|0

-CASE MultiTableSelectionAndNamedYield
-STATEMENT CREATE NODE TABLE Person(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE NODE TABLE City(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE REL TABLE Links(FROM Person TO Person, FROM Person TO City)
---- ok
-STATEMENT CREATE (:Person {id: 0}), (:Person {id: 1}), (:City {id: 10}), (:City {id: 11})
---- ok
-STATEMENT MATCH (a:Person), (b:Person) WHERE a.id = 0 AND b.id = 1 CREATE (a)-[:Links]->(b)
---- ok
-STATEMENT MATCH (a:Person), (b:City) WHERE (a.id = 0 OR a.id = 1) AND b.id = 10 CREATE (a)-[:Links]->(b)
---- ok
-STATEMENT CALL k_core_decomposition(['City','Person'], ['Links']) YIELD core AS k, node AS member RETURN label(member), member.id, k ORDER BY label(member), member.id
-CHECK_ORDER
---- 4
City|10|2
City|11|0
Person|0|2
Person|1|2
-STATEMENT CALL k_core_decomposition(['City','Person'], ['Links']) YIELD core WHERE core >= 2 RETURN count(*), max(core)
---- 1
3|2

-CASE TransactionVisibility
-STATEMENT CREATE NODE TABLE N(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE REL TABLE E(FROM N TO N)
---- ok
-STATEMENT CREATE (:N {id: 0}), (:N {id: 1})
---- ok
-STATEMENT MATCH (a:N), (b:N) WHERE a.id = 0 AND b.id = 1 CREATE (a)-[:E]->(b)
---- ok
-STATEMENT BEGIN TRANSACTION
---- ok
-STATEMENT MATCH (:N)-[edge:E]->(:N) DELETE edge
---- ok
-STATEMENT CALL k_core_decomposition(['N'], ['E']) YIELD node, core RETURN node.id, core ORDER BY node.id
-CHECK_ORDER
---- 2
0|0
1|0
-STATEMENT ROLLBACK
---- ok
-STATEMENT CALL k_core_decomposition(['N'], ['E']) YIELD node, core RETURN node.id, core ORDER BY node.id
-CHECK_ORDER
---- 2
0|1
1|1
-STATEMENT BEGIN TRANSACTION
---- ok
-STATEMENT MATCH (n:N) WHERE n.id = 1 DETACH DELETE n
---- ok
-STATEMENT CALL k_core_decomposition(['N'], ['E']) YIELD node, core RETURN node.id, core
---- 1
0|0
-STATEMENT ROLLBACK
---- ok

-CASE SelectionValidation
-STATEMENT CREATE NODE TABLE N(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE NODE TABLE M(id INT64, PRIMARY KEY(id))
---- ok
-STATEMENT CREATE REL TABLE E(FROM N TO M)
---- ok
-STATEMENT CALL k_core_decomposition(['N']) YIELD node, core RETURN node
---- error
Binder exception: Function k_core_decomposition did not receive correct arguments:
Actual:   (1 arguments)
Expected: (LIST<STRING>,LIST<STRING>)
-STATEMENT CALL k_core_decomposition('N', ['E']) YIELD node, core RETURN node
---- error
Binder exception: Argument 1 of k_core_decomposition must be LIST<STRING>, but STRING was provided.
-STATEMENT CALL k_core_decomposition([1], ['E']) YIELD node, core RETURN node
---- error
Binder exception: Element 1 of argument 1 to k_core_decomposition must be STRING, but INT64 was provided.
-STATEMENT CALL k_core_decomposition(['N','N'], []) YIELD node, core RETURN node
---- error
Binder exception: Duplicate node table in graph selection: N.
-STATEMENT CALL k_core_decomposition(['N','M'], ['E','E']) YIELD node, core RETURN node
---- error
Binder exception: Duplicate relationship table in graph selection: E.
-STATEMENT CALL k_core_decomposition(['Missing'], []) YIELD node, core RETURN node
---- error
Binder exception: Node table Missing does not exist.
-STATEMENT CALL k_core_decomposition(['N','M'], ['Missing']) YIELD node, core RETURN node
---- error
Binder exception: Relationship table Missing does not exist.
-STATEMENT CALL k_core_decomposition(['N'], ['E']) YIELD node, core RETURN node
---- error
Binder exception: Relationship table E references node table M, which is not in the graph selection.
