-DATASET CSV empty
--
-CASE TimestampPrecisionCast
-STATEMENT RETURN cast("1970-01-01 00:00:00.004666-10", "TIMESTAMP")
---- 1
1970-01-01 10:00:00.004666
-STATEMENT RETURN cast("1970-01-01 00:00:00.00466612-10", "TIMESTAMP_MS")
---- 1
1970-01-01 10:00:00.004
-STATEMENT RETURN cast("1970-01-01 00:00:00.00466612-10", "TIMESTAMP_NS")
---- 1
1970-01-01 10:00:00.004666
-STATEMENT RETURN cast("1970-01-01 00:00:00.004666-10", "TIMESTAMP_SEC")
---- 1
1970-01-01 10:00:00
-STATEMENT RETURN cast("1970-01-01 00:00:00.004666-10", "TIMESTAMP_TZ")
---- 1
1970-01-01 10:00:00.004666+00

-CASE TimestampPrecisionEquality
-STATEMENT RETURN cast('1972-07-31 13:22:30.678559', "TIMESTAMP_TZ") = cast('1972-07-31 13:22:30.678559', "TIMESTAMP_NS")
---- 1
True
-STATEMENT RETURN cast('1972-07-31 13:22:30.678559', "TIMESTAMP") = cast('1972-07-31 13:22:30.678559123', "TIMESTAMP_NS")
---- 1
True
-STATEMENT RETURN cast('1972-07-31 13:22:30.678559', "TIMESTAMP_MS") = cast('1972-07-31 13:22:30.678559123', "TIMESTAMP_S")
---- 1
False
-STATEMENT RETURN cast('1972-07-31 13:22:30.678559', "TIMESTAMP_MS") = cast('1972-07-31 13:22:30.678559123', "TIMESTAMP_NS")
---- 1
False
-STATEMENT RETURN cast("1972-07-31 00:00:00.00012", "TIMESTAMP_MS") >= date('1972-07-31')
---- 1
True
-STATEMENT RETURN cast("1972-07-31 00:00:00.00012", "TIMESTAMP_SEC") <= date('1972-07-31')
---- 1
True

-CASE TimestampToString
-STATEMENT RETURN cast(cast('1972-07-31 13:22:30.678559', "TIMESTAMP_MS"), "STRING")
---- 1
1972-07-31 13:22:30.678
-STATEMENT RETURN cast(cast('1972-07-31 13:22:30.678559', "TIMESTAMP_SEC"), "STRING")
---- 1
1972-07-31 13:22:30
-STATEMENT RETURN cast(cast('1972-07-31 13:22:30.678559', "TIMESTAMP_NS"), "STRING")
---- 1
1972-07-31 13:22:30.678559
