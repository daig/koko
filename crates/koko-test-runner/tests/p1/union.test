-DATASET CSV tinysnb
--
# D3 gate: UNION / UNION ALL against tinysnb. Statements + expected results are
# byte-exact from the C++ corpus (nested_types/nested_types.test, agg, and
# exceptions/binder/binder_error.test).

-CASE Union
# UNION ALL — concatenate, keep duplicates (8 ages twice).
-STATEMENT MATCH (p:person) RETURN p.age UNION ALL MATCH (p1:person) RETURN p1.age
---- 16
20
20
20
20
25
25
30
30
35
35
40
40
45
45
83
83
# UNION — deduplicate (7 distinct ages; two people are 20).
-STATEMENT MATCH (a:person) RETURN a.age UNION MATCH (p:person) RETURN p.age
---- 7
20
25
30
35
40
45
83
# Chained UNION ALL (3 operands).
-STATEMENT MATCH (p:person) RETURN p.age UNION ALL MATCH (p1:person) RETURN p1.age UNION ALL MATCH (p2:person) RETURN p2.age
