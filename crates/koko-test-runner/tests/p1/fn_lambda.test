-DATASET CSV tinysnb
--
-CASE Lambdas
-STATEMENT RETURN list_transform([1,3,2], x->x+5)
---- 1
[6,8,7]
-STATEMENT RETURN list_transform(list_transform([1,3,2], x->x+5), y->y+3)
---- 1
[9,11,10]
-STATEMENT RETURN list_filter([1,2,3,4,5], x->x>=3)
---- 1
[3,4,5]
-STATEMENT RETURN list_filter([5,2,3], x->true)
---- 1
[5,2,3]
-STATEMENT RETURN list_reduce([1,2,3,4], (x,y)->x+y)
---- 1
10
-CASE Comprehension
-STATEMENT RETURN [x IN [1,2,3,4,5] WHERE x > 2 | x * 10]
---- 1
[30,40,50]
-STATEMENT RETURN [n IN [1,2,3] | n + 1]
---- 1
[2,3,4]
-CASE LambdaOuterRef
-STATEMENT MATCH (a:person) WHERE a.ID < 6 RETURN a.age, list_transform([1,2,3], x->x + a.age)
---- 4
20|[21,22,23]
30|[31,32,33]
35|[36,37,38]
45|[46,47,48]
