-DATASET CSV tinysnb
--
-CASE UnwindBasic
-STATEMENT UNWIND [1,2,3] AS x RETURN x
---- 3
1
2
3
-STATEMENT UNWIND [1,2,3] AS x RETURN x * 10
---- 3
10
20
30
-STATEMENT UNWIND [] AS x RETURN x
---- 0
-STATEMENT UNWIND [1, NULL, 3] AS x RETURN x
---- 3
1

3
-STATEMENT UNWIND ['a','b'] AS x UNWIND [1,2] AS y RETURN x, y
---- 4
a|1
a|2
b|1
b|2
-CASE UnwindAgg
-STATEMENT UNWIND [10, 20, 30] AS x RETURN sum(x), count(x)
---- 1
60|3
-CASE UnwindFnCorpus
-STATEMENT UNWIND [CAST(128 AS INT16)] AS A RETURN abs(A)
---- 1
128
-CASE UnwindMatch
-STATEMENT MATCH (a:person) WHERE a.ID < 3 UNWIND a.workedHours AS h RETURN a.fName, h
---- 4
Alice|10
Alice|5
Bob|12
Bob|8
