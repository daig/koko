// decimal cast rendering + trailing zeros
RETURN CAST(1.5 AS DECIMAL(4,2))
RETURN CAST(1.5 AS DECIMAL(10,4))
RETURN CAST(0 AS DECIMAL(4,2))
RETURN CAST(5 AS DECIMAL(6,3))
RETURN CAST(-0.01 AS DECIMAL(4,2))
RETURN CAST(-0.001 AS DECIMAL(5,3))
RETURN CAST(-1 AS DECIMAL(5,3))
// decimal cast rounding (half away?)
RETURN CAST(1.555 AS DECIMAL(4,2))
RETURN CAST(1.554 AS DECIMAL(4,2))
RETURN CAST(1.545 AS DECIMAL(4,2))
RETURN CAST(-1.555 AS DECIMAL(5,2))
RETURN CAST(2.5 AS DECIMAL(4,0))
// decimal overflow
RETURN CAST(100 AS DECIMAL(4,2))
RETURN CAST(99.99 AS DECIMAL(4,2))
RETURN CAST(99.999 AS DECIMAL(4,2))
// arithmetic precision/scale inference
RETURN typeof(CAST(1.5 AS DECIMAL(4,2)) + 1)
RETURN CAST(1.5 AS DECIMAL(4,2)) + 1
RETURN typeof(CAST(1.5 AS DECIMAL(4,2)) + CAST(1.5 AS DECIMAL(4,2)))
RETURN CAST(1.5 AS DECIMAL(4,2)) + CAST(1.5 AS DECIMAL(4,2))
RETURN typeof(CAST(1.5 AS DECIMAL(4,2)) * CAST(1.5 AS DECIMAL(4,2)))
RETURN CAST(1.5 AS DECIMAL(4,2)) * CAST(1.5 AS DECIMAL(4,2))
RETURN typeof(CAST(1.5 AS DECIMAL(4,2)) - CAST(0.5 AS DECIMAL(6,4)))
RETURN typeof(CAST(1.5 AS DECIMAL(4,2)) + 1.0)
RETURN CAST(1.5 AS DECIMAL(4,2)) + 1.0
RETURN typeof(CAST(10 AS DECIMAL(4,2)) / CAST(3 AS DECIMAL(4,2)))
RETURN CAST(10 AS DECIMAL(4,2)) / CAST(3 AS DECIMAL(4,2))
// string -> decimal (exponent?)
RETURN CAST('1.5' AS DECIMAL(4,2))
RETURN CAST('1.555' AS DECIMAL(4,2))
RETURN CAST('1e2' AS DECIMAL(6,2))
RETURN CAST('+1.5' AS DECIMAL(4,2))
RETURN CAST('  1.5  ' AS DECIMAL(4,2))
// decimal comparisons
RETURN CAST(1.5 AS DECIMAL(4,2)) = 1.5
RETURN CAST(1 AS DECIMAL(4,2)) = 1
RETURN 1 < CAST(1.5 AS DECIMAL(4,2))
// decimal(38) boundary
RETURN typeof(CAST(1 AS DECIMAL(38,0)))
RETURN CAST(12345678901234567890123456789012345678 AS DECIMAL(38,0))
