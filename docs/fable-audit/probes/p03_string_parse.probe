RETURN CAST('1e' AS DOUBLE)
RETURN CAST('+1.5' AS DOUBLE)
RETURN CAST('1.5' AS FLOAT)
RETURN CAST('abc' AS DOUBLE)
// string -> BOOL
RETURN CAST('true' AS BOOL)
RETURN CAST('True' AS BOOL)
RETURN CAST('TRUE' AS BOOL)
RETURN CAST('t' AS BOOL)
RETURN CAST('1' AS BOOL)
RETURN CAST('yes' AS BOOL)
