RETURN CAST('0' AS BOOL)
RETURN CAST(' true ' AS BOOL)
RETURN CAST('FALSE' AS BOOL)
// string -> DATE
RETURN CAST('2020-01-01' AS DATE)
RETURN CAST('2020-1-1' AS DATE)
RETURN CAST('2020/01/01' AS DATE)
RETURN CAST('2020-02-30' AS DATE)
RETURN CAST('2020-13-01' AS DATE)
RETURN CAST('2020-00-01' AS DATE)
RETURN CAST('2020-02-29' AS DATE)
RETURN CAST('2021-02-29' AS DATE)
RETURN CAST(' 2020-01-01 ' AS DATE)
RETURN CAST('01-01-2020' AS DATE)
RETURN CAST('2020-01-01x' AS DATE)
// string -> TIMESTAMP
RETURN CAST('2020-01-01 12:00:00' AS TIMESTAMP)
RETURN CAST('2020-01-01T12:00:00' AS TIMESTAMP)
RETURN CAST('2020-01-01' AS TIMESTAMP)
RETURN CAST('2020-01-01 12:00:00.123456' AS TIMESTAMP)
RETURN CAST('2020-01-01 12:00:00.123' AS TIMESTAMP)
RETURN CAST('2020-01-01 12:00:00+02' AS TIMESTAMP)
RETURN CAST('2020-01-01 12:00:00Z' AS TIMESTAMP)
