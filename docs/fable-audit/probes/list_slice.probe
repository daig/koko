// slicing
RETURN list_slice([1,2,3,4,5], 2, 4) AS a
RETURN [1,2,3,4,5][2:4] AS a
RETURN [1,2,3,4,5][2:] AS a
RETURN [1,2,3,4,5][:3] AS a
RETURN [1,2,3,4,5][-2:] AS a
RETURN [1,2,3,4,5][:-1] AS a
RETURN [1,2,3,4,5][4:2] AS a
RETURN [1,2,3,4,5][0:2] AS a
RETURN [1,2,3,4,5][2:100] AS a
RETURN [1,2,3,4,5][-100:2] AS a
RETURN [1,2,3,4,5][1:1] AS a
RETURN [1,2,3,4,5][:] AS a
RETURN list_slice([1,2,3,4,5], 0, 2) AS a
RETURN list_slice([1,2,3,4,5], 2, 100) AS a
RETURN list_slice([1,2,3,4,5], -2, 5) AS a
RETURN list_slice([1,2,3,4,5], 4, 2) AS a
RETURN array_slice([1,2,3,4,5], 2, 4) AS a
RETURN list_slice(NULL, 1, 2) AS a
RETURN [1,2,3,4,5][NULL:2] AS a
RETURN list_slice([1,2,3,4,5], 1, 3) AS a
