// integer literal typing by magnitude
RETURN typeof(0)
RETURN typeof(127)
RETURN typeof(128)
RETURN typeof(255)
RETURN typeof(32767)
RETURN typeof(32768)
RETURN typeof(2147483647)
RETURN typeof(2147483648)
RETURN typeof(4294967295)
RETURN typeof(4294967296)
RETURN typeof(9223372036854775807)
RETURN typeof(9223372036854775808)
RETURN typeof(18446744073709551615)
RETURN typeof(18446744073709551616)
RETURN typeof(170141183460469231731687303715884105727)
RETURN typeof(170141183460469231731687303715884105728)
RETURN typeof(340282366920938463463374607431768211455)
RETURN typeof(340282366920938463463374607431768211456)
RETURN typeof(-1)
RETURN typeof(-128)
RETURN typeof(-9223372036854775808)
RETURN typeof(-170141183460469231731687303715884105728)
// rendering of big ints
RETURN 9223372036854775808
RETURN 170141183460469231731687303715884105727
RETURN -170141183460469231731687303715884105728
// float literal typing
RETURN typeof(1.5)
RETURN typeof(0.0)
RETURN typeof(-0.0)
RETURN typeof(1e300)
RETURN typeof(1e-300)
RETURN typeof(1e400)
RETURN typeof(.5)
RETURN typeof(5.)
RETURN typeof(1E10)
RETURN typeof(1.5e2)
RETURN typeof(1e3)
RETURN 1e3
RETURN typeof(3.14)
// bool/string/null
RETURN typeof(true)
RETURN typeof(false)
RETURN typeof('abc')
RETURN typeof(null)
// arithmetic result typing
RETURN typeof(1+1)
RETURN typeof(1+1.0)
RETURN typeof(1.0+1)
RETURN typeof(2147483647+1)
RETURN typeof(9223372036854775807+1)
RETURN typeof(1/2)
RETURN 1/2
RETURN typeof(3.0/2)
RETURN 3.0/2
RETURN typeof(1*1.0)
RETURN typeof(-1)
RETURN typeof(- 1)
RETURN typeof(5 % 2)
