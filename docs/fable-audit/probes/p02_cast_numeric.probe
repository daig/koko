// float->int rounding (half cases)
RETURN CAST(0.5 AS INT64)
RETURN CAST(1.5 AS INT64)
RETURN CAST(2.5 AS INT64)
RETURN CAST(3.5 AS INT64)
RETURN CAST(-0.5 AS INT64)
RETURN CAST(-1.5 AS INT64)
RETURN CAST(-2.5 AS INT64)
RETURN CAST(1.4 AS INT64)
RETURN CAST(1.6 AS INT64)
RETURN CAST(-1.4 AS INT64)
RETURN CAST(-1.6 AS INT64)
RETURN CAST(2.4 AS INT64)
RETURN CAST(2.6 AS INT64)
RETURN CAST(0.49999 AS INT64)
RETURN CAST(1.5 AS INT8)
RETURN CAST(1.5 AS INT16)
RETURN CAST(1.5 AS INT32)
RETURN CAST(1.5 AS INT128)
RETURN CAST(1.5 AS UINT8)
RETURN CAST(2.5 AS UINT32)
RETURN CAST(1.99 AS INT8)
RETURN CAST(3.99 AS INT64)
RETURN CAST(-3.99 AS INT64)
// float->int via FLOAT
RETURN CAST(CAST(2.5 AS FLOAT) AS INT64)
// double->float
RETURN CAST(1.5 AS FLOAT)
RETURN CAST(3.14159265358979 AS FLOAT)
RETURN CAST(1e300 AS FLOAT)
RETURN CAST(1e-300 AS FLOAT)
RETURN CAST(CAST(1.5 AS FLOAT) AS DOUBLE)
RETURN CAST(CAST(3.14 AS FLOAT) AS DOUBLE)
// int width overflow on cast
RETURN CAST(128 AS INT8)
RETURN CAST(-128 AS INT8)
RETURN CAST(-129 AS INT8)
RETURN CAST(255 AS UINT8)
RETURN CAST(256 AS UINT8)
RETURN CAST(-1 AS UINT8)
RETURN CAST(70000 AS INT16)
RETURN CAST(2147483648 AS INT32)
RETURN CAST(-5 AS UINT32)
RETURN CAST(300 AS INT8)
// double->int overflow
RETURN CAST(1e300 AS INT64)
RETURN CAST(1e300 AS INT32)
RETURN CAST(1e19 AS INT64)
RETURN CAST(9223372036854775807 AS DOUBLE)
// bool<->int
RETURN CAST(true AS INT64)
RETURN CAST(false AS INT64)
RETURN CAST(1 AS BOOL)
RETURN CAST(0 AS BOOL)
RETURN CAST(2 AS BOOL)
RETURN CAST(-1 AS BOOL)
// null
RETURN CAST(NULL AS INT64)
RETURN CAST(NULL AS STRING)
// int<->decimal
RETURN CAST(5 AS DECIMAL(10,2))
RETURN CAST(5 AS DECIMAL(4,2))
RETURN typeof(CAST(5 AS DECIMAL(10,2)))
// serial/uint128
RETURN CAST(5 AS SERIAL)
RETURN CAST(5 AS UINT128)
RETURN CAST(-5 AS UINT128)
