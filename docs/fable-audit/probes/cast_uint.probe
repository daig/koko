// CAST to unsigned int types + to_uintN — negatives, overflow
RETURN CAST(-1 AS UINT8)
RETURN CAST(255 AS UINT8)
RETURN CAST(256 AS UINT8)
RETURN CAST(0 AS UINT8)
RETURN CAST(-1 AS UINT16)
RETURN CAST(65535 AS UINT16)
RETURN CAST(65536 AS UINT16)
RETURN CAST(-1 AS UINT32)
RETURN CAST(4294967295 AS UINT32)
RETURN CAST(-1 AS UINT64)
RETURN CAST(18446744073709551615 AS UINT64)
RETURN to_uint8(200)
RETURN to_uint8(300)
RETURN to_uint8(-5)
RETURN to_uint16(70000)
RETURN to_uint32(5000000000)
RETURN to_uint64(-1)
RETURN to_uint128('340282366920938463463374607431768211455')
RETURN CAST(3.9 AS UINT8)
RETURN CAST('255' AS UINT8)
RETURN CAST('-1' AS UINT8)
RETURN CAST(null AS UINT8)
RETURN to_serial(5)
RETURN to_serial(-3)
