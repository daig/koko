CALL db_version() RETURN *
CALL current_setting('threads') RETURN *
CALL show_tables() RETURN count(*)
CALL table_info('person') RETURN count(*)
CALL show_connection('knows') RETURN *
CALL storage_info('person') RETURN count(*)
CALL show_sequences() RETURN count(*)
CALL show_indexes() RETURN count(*)
CALL show_warnings() RETURN count(*)
CALL stats_info('person') RETURN count(*)
