// CAST to signed int types + to_intN — overflow, truncation, parse
RETURN CAST(300 AS INT8)
RETURN CAST(127 AS INT8)
RETURN CAST(-128 AS INT8)
RETURN CAST(128 AS INT8)
RETURN CAST(3.9 AS INT64)
RETURN CAST(3.5 AS INT64)
RETURN CAST(-3.9 AS INT64)
RETURN CAST(2.5 AS INT64)
RETURN CAST('abc' AS INT64)
RETURN CAST('' AS INT64)
RETURN CAST('123' AS INT64)
RETURN CAST('  42  ' AS INT64)
RETURN CAST('1.5' AS INT64)
RETURN CAST(true AS INT64)
RETURN CAST(false AS INT64)
RETURN CAST(32768 AS INT16)
RETURN CAST(-32769 AS INT16)
RETURN CAST(2147483648 AS INT32)
RETURN to_int8(100)
RETURN to_int8(200)
RETURN to_int16(40000)
RETURN to_int32(3000000000)
RETURN to_int64('9223372036854775807')
RETURN to_int128('170141183460469231731687303715884105727')
RETURN CAST(170141183460469231731687303715884105728 AS INT128)
RETURN to_int64(3.99)
RETURN CAST(9223372036854775807 AS INT8)
RETURN CAST(null AS INT64)
RETURN to_int32(null)
