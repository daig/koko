RETURN CASE 1 WHEN NULL THEN 'a' ELSE 'b' END AS x
RETURN CASE 1 WHEN NULL THEN 'a' WHEN 1 THEN 'c' ELSE 'b' END AS x
RETURN CASE 2 WHEN NULL THEN 'a' WHEN 1 THEN 'c' ELSE 'b' END AS x
RETURN CASE NULL WHEN NULL THEN 'a' ELSE 'b' END AS x
RETURN CASE NULL WHEN 1 THEN 'a' ELSE 'b' END AS x
RETURN CASE 1 WHEN NULL THEN 'a' END AS x
RETURN CASE 'x' WHEN NULL THEN 'a' ELSE 'b' END AS x
RETURN CASE NULL WHEN NULL THEN 'a' WHEN NULL THEN 'c' ELSE 'b' END AS x
RETURN CASE WHEN NULL THEN 'a' ELSE 'b' END AS x
RETURN NULLIF(NULL, 1) AS x
RETURN NULLIF(NULL, NULL) AS x
RETURN NULLIF(1, NULL) AS x
RETURN NOT (1 IN [2,3]) AS x
RETURN NOT (1 IN [1,2]) AS x
