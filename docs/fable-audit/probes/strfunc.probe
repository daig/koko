RETURN starts_with('hello','he') AS x
RETURN starts_with('hello','') AS x
RETURN starts_with('','') AS x
RETURN starts_with('hello',NULL) AS x
RETURN starts_with(NULL,'a') AS x
RETURN ends_with('hello','lo') AS x
RETURN ends_with('hello','') AS x
RETURN contains('hello','ell') AS x
RETURN contains('hello','') AS x
RETURN contains('','') AS x
RETURN contains('hello',NULL) AS x
RETURN contains('héllo','ll') AS x
RETURN contains('日本語','本') AS x
RETURN regexp_matches('hello','h.*o') AS x
RETURN regexp_matches('hello','ell') AS x
RETURN regexp_matches('hello','.ell.') AS x
RETURN regexp_matches('','') AS x
RETURN regexp_matches('a','') AS x
RETURN regexp_matches('hello','(') AS x
RETURN regexp_matches('ABC','(?i)abc') AS x
RETURN regexp_matches('hello',NULL) AS x
RETURN regexp_matches(NULL,'a') AS x
RETURN typeof(contains('a','b')) AS x
