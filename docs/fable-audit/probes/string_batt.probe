// case folding breadth
RETURN upper('ﬁ')
RETURN upper('ﬀ')
RETURN lower('ΣΟΣ')
RETURN upper('ı')
RETURN initcap('hello world')
RETURN initcap("o'brien mcdonald")
RETURN initcap('123abc def')
// pad edges
RETURN lpad('hello', 3, 'x')
RETURN rpad('hello', 3, 'x')
RETURN lpad('ab', 7, 'xy')
RETURN rpad('ab', 7, 'xy')
RETURN lpad('x', 0, 'y')
RETURN lpad('x', -1, 'y')
RETURN lpad('x', 5, '')
// repeat edges
RETURN repeat('ab', 0)
RETURN repeat('ab', -3)
RETURN repeat('', 5)
// substr edges
RETURN substr('hello', 0, 3)
RETURN substr('hello', -1, 2)
RETURN substr('hello', 2, 100)
RETURN substr('hello', 3, 0)
RETURN substr('hello', 3, -1)
RETURN left('hi', -1)
RETURN left('hi', 5)
RETURN right('hi', 10)
// split
RETURN string_split('a,b,,c', ',')
RETURN string_split('abc', '')
RETURN string_split('abc', 'x')
RETURN string_split(',a,', ',')
RETURN split_part('a,b,c', ',', 2)
RETURN split_part('a,b,c', ',', 0)
RETURN split_part('a,b,c', ',', 9)
// levenshtein
RETURN levenshtein('', 'abc')
RETURN levenshtein('abc', 'abc')
RETURN levenshtein('kitten', 'sitting')
RETURN levenshtein('café', 'cafe')
// concat / list_to_string with null
RETURN concat('a', null, 'b')
RETURN concat(null, null)
RETURN [list_to_string([1,null,3], ',')]
RETURN list_to_string([], ',')
// regexp
RETURN regexp_matches('abc123', '[0-9]+')
RETURN regexp_full_match('abc123', '[a-z]+')
RETURN regexp_replace('aaa', 'a', 'b')
RETURN regexp_replace('hello world', '(\w+) (\w+)', '\2 \1')
RETURN regexp_extract('2024-01-05', '(\d+)-(\d+)', 1)
RETURN regexp_extract('abc', '(a)(b)', 2)
RETURN regexp_matches('ABC', '(?i)abc')
RETURN regexp_matches('café', '\w+')
RETURN regexp_replace('a1b2c3', '[0-9]', 'X')
RETURN regexp_extract_all('a1b2c3', '[0-9]')
// trim custom chars
RETURN trim('xxhelloxx', 'x')
RETURN ltrim('xxhello', 'x')
