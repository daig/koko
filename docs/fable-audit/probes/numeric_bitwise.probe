// bitwise_and/or/xor, bitshift_left/right
RETURN bitwise_and(12, 10)
RETURN bitwise_or(12, 10)
RETURN bitwise_xor(12, 10)
RETURN bitwise_and(-1, 255)
RETURN bitwise_or(-1, 0)
RETURN bitwise_xor(-1, -1)
RETURN bitwise_and(-8, -3)
RETURN bitshift_left(1, 4)
RETURN bitshift_right(256, 4)
RETURN bitshift_left(1, 63)
RETURN bitshift_left(1, 64)
RETURN bitshift_left(1, 65)
RETURN bitshift_right(-256, 4)
RETURN bitshift_right(1024, 64)
RETURN bitshift_left(-1, 1)
RETURN bitwise_and(null, 1)
RETURN bitwise_or(1, null)
RETURN bitshift_left(null, 2)
RETURN bitshift_left(2, null)
