// date_part on INTERVAL
RETURN date_part('year', INTERVAL('1 year 2 months'))
RETURN date_part('month', INTERVAL('1 year 2 months'))
RETURN date_part('day', INTERVAL('1 year 2 months 10 days'))
RETURN date_part('hour', INTERVAL('25 hours'))
RETURN date_part('minute', INTERVAL('90 minutes'))
RETURN date_part('second', INTERVAL('90 seconds'))
RETURN date_part('millisecond', INTERVAL('1500 milliseconds'))
RETURN date_part('microsecond', INTERVAL('1500 milliseconds'))
RETURN date_part('decade', INTERVAL('25 years'))
RETURN date_part('century', INTERVAL('250 years'))
RETURN date_part('millennium', INTERVAL('2500 years'))
RETURN date_part('quarter', INTERVAL('7 months'))
RETURN date_part('week', INTERVAL('20 days'))
RETURN date_part('dow', INTERVAL('20 days'))
RETURN date_part('epoch', INTERVAL('1 day'))
RETURN date_part('doy', INTERVAL('1 year'))
