// index base & bounds
RETURN list_extract([10,20,30], 1) AS a
RETURN list_extract([10,20,30], 0) AS a
RETURN list_extract([10,20,30], -1) AS a
RETURN list_extract([10,20,30], 3) AS a
RETURN list_extract([10,20,30], 4) AS a
RETURN list_extract([10,20,30], -3) AS a
RETURN list_extract([10,20,30], -4) AS a
RETURN list_element([10,20,30], 2) AS a
RETURN array_extract([10,20,30], 2) AS a
RETURN [1,2,3][1] AS a
RETURN [1,2,3][0] AS a
RETURN [1,2,3][-1] AS a
RETURN [1,2,3][3] AS a
RETURN [1,2,3][4] AS a
RETURN [10,20,30][-1] AS a
RETURN [10,20,30][-3] AS a
RETURN [10,20,30][-4] AS a
RETURN list_extract(NULL, 1) AS a
RETURN list_extract([10,20,30], NULL) AS a
RETURN [1,2,3][NULL] AS a
RETURN typeof(list_extract([10,20,30], 4)) AS a
RETURN list_extract(['a','b','c'], 2) AS a
