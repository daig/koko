// date_trunc every keyword on a TIMESTAMP (2024-08-15 13:45:30.123456)
RETURN date_trunc('year', TIMESTAMP('2024-08-15 13:45:30.123456'))
RETURN date_trunc('month', TIMESTAMP('2024-08-15 13:45:30.123456'))
RETURN date_trunc('day', TIMESTAMP('2024-08-15 13:45:30.123456'))
RETURN date_trunc('hour', TIMESTAMP('2024-08-15 13:45:30.123456'))
RETURN date_trunc('minute', TIMESTAMP('2024-08-15 13:45:30.123456'))
RETURN date_trunc('second', TIMESTAMP('2024-08-15 13:45:30.123456'))
RETURN date_trunc('millisecond', TIMESTAMP('2024-08-15 13:45:30.123456'))
RETURN date_trunc('microsecond', TIMESTAMP('2024-08-15 13:45:30.123456'))
RETURN date_trunc('decade', TIMESTAMP('2024-08-15 13:45:30.123456'))
RETURN date_trunc('century', TIMESTAMP('2024-08-15 13:45:30.123456'))
RETURN date_trunc('millennium', TIMESTAMP('2024-08-15 13:45:30.123456'))
RETURN date_trunc('quarter', TIMESTAMP('2024-08-15 13:45:30.123456'))
RETURN date_trunc('week', TIMESTAMP('2024-08-15 13:45:30.123456'))
// date_trunc on DATE
RETURN date_trunc('year', DATE('2024-08-15'))
RETURN date_trunc('month', DATE('2024-08-15'))
RETURN date_trunc('day', DATE('2024-08-15'))
RETURN date_trunc('quarter', DATE('2024-08-15'))
RETURN date_trunc('decade', DATE('2024-08-15'))
RETURN date_trunc('century', DATE('2024-08-15'))
RETURN date_trunc('week', DATE('2024-08-15'))
RETURN date_trunc('hour', DATE('2024-08-15'))
// alias
RETURN datetrunc('month', TIMESTAMP('2024-08-15 13:45:30.123456'))
// century boundary trunc
RETURN date_trunc('century', TIMESTAMP('2001-06-15 00:00:00'))
