RETURN regexp_matches('hello world','wor')
RETURN regexp_matches('hello','^h')
RETURN regexp_matches('Hello','(?i)hello')
RETURN regexp_full_match('hello','hello')
RETURN regexp_full_match('hello','hel')
RETURN regexp_full_match('hello','hel.*')
RETURN regexp_replace('aaa','a','b')
RETURN regexp_replace('hello world','o','0')
RETURN regexp_replace('a1b2c3','[0-9]','#')
RETURN regexp_extract('2020-01-02','[0-9]+')
RETURN regexp_extract('2020-01-02','([0-9]+)-([0-9]+)',2)
RETURN regexp_extract('abc','([0-9]+)')
RETURN regexp_extract_all('a1b2c3','[0-9]')
RETURN regexp_extract_all('abc','[0-9]')
RETURN regexp_split_to_array('a1b2c3','[0-9]')
RETURN regexp_matches('café','\w+')
RETURN regexp_extract('café','\w+')
RETURN regexp_matches('abc','')
RETURN regexp_replace('abc','','X')
RETURN regexp_matches('a.b','.')
RETURN regexp_matches('hello','[')
RETURN regexp_replace('a1b2','([0-9])','<\1>')
RETURN regexp_matches('AAA','a+')
RETURN size(regexp_extract_all('a1b2c3','[0-9]'))
