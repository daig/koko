// TO-STRING coercion across all string fns (INT arg in a STRING position)
RETURN lower(123)
RETURN upper(123)
RETURN trim(123)
RETURN ltrim(123)
RETURN rtrim(123)
RETURN initcap(123)
RETURN reverse(123)
RETURN length(123)
RETURN left(123, 2)
RETURN right(123, 2)
RETURN lpad(12, 5, 0)
RETURN rpad(12, 5, 0)
RETURN substr(12345, 1, 3)
RETURN repeat(12, 3)
RETURN contains(12345, 23)
RETURN starts_with(12345, 12)
RETURN ends_with(12345, 45)
RETURN prefix(12345, 12)
RETURN suffix(12345, 45)
RETURN string_split(12345, 3)
RETURN split_part(12345, 3, 1)
RETURN levenshtein(123, 124)
RETURN replace(12321, 2, 9)
RETURN regexp_matches(12345, 234)
RETURN regexp_replace(12345, 3, 9)
RETURN concat(1, 2, 3)
RETURN size(12345)
RETURN list_to_string([1,2,3], 0)
// reverse direction Rust-permissive bugs: DOUBLE in INT position
RETURN left('hello', 2.0)
RETURN right('hello', 2.0)
RETURN substr('hello', 1.0, 3.0)
RETURN repeat('ab', 2.0)
RETURN lpad('x', 4.0, 'y')
RETURN factorial('5')
RETURN list_contains([1,2,3], '2')
RETURN date('2024-01-05') = '2024-01-05'
RETURN 1 = '1'
RETURN sin(1)
RETURN abs(1.5)
