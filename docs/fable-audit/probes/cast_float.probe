// to_double, to_float, CAST DOUBLE/FLOAT, inf/nan parsing
RETURN CAST('inf' AS DOUBLE)
RETURN CAST('-inf' AS DOUBLE)
RETURN CAST('nan' AS DOUBLE)
RETURN CAST('Infinity' AS DOUBLE)
RETURN CAST('1.5' AS DOUBLE)
RETURN CAST('  2.5  ' AS DOUBLE)
RETURN CAST('abc' AS DOUBLE)
RETURN CAST('' AS DOUBLE)
RETURN CAST(3 AS DOUBLE)
RETURN CAST(3 AS FLOAT)
RETURN to_double(5)
RETURN to_double('3.14')
RETURN to_float(3.141592653589793)
RETURN to_float(1e40)
RETURN CAST(1e400 AS DOUBLE)
RETURN CAST('1e400' AS DOUBLE)
RETURN to_double(true)
RETURN CAST(3.14159265358979 AS FLOAT)
RETURN CAST(1.5 AS DOUBLE) / 0.0
RETURN to_float(null)
RETURN to_double(null)
RETURN CAST('1.5e2' AS DOUBLE)
RETURN CAST('0x10' AS INT64)
