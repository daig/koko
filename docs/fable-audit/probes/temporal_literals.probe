// Direct rendering of DATE/TIMESTAMP/INTERVAL literals (must be byte-identical)
RETURN DATE('2024-07-01')
RETURN DATE('2024-1-5')
RETURN DATE('1970-01-01')
RETURN DATE('0001-01-01')
RETURN DATE('-0001-01-01')
RETURN DATE('2024-02-29')
RETURN TIMESTAMP('2024-01-05 12:34:56')
RETURN TIMESTAMP('2024-01-05 12:34:56.789')
RETURN TIMESTAMP('2024-01-05 12:34:56.123456')
RETURN TIMESTAMP('2024-01-05')
RETURN TIMESTAMP('2024-01-05T12:34:56')
RETURN INTERVAL('1 year')
RETURN INTERVAL('2 years')
RETURN INTERVAL('1 year 2 months')
RETURN INTERVAL('1 month')
RETURN INTERVAL('1 day')
RETURN INTERVAL('3 days')
RETURN INTERVAL('1 hour')
RETURN INTERVAL('90 minutes')
RETURN INTERVAL('36 hours')
RETURN INTERVAL('1 year 13 months')
RETURN INTERVAL('1 day 2 hours 3 minutes 4 seconds')
RETURN INTERVAL('1.5 hours')
RETURN INTERVAL('100 milliseconds')
RETURN INTERVAL('1500 milliseconds')
RETURN INTERVAL('90 seconds')
RETURN INTERVAL('-1 year')
RETURN INTERVAL('-90 minutes')
RETURN INTERVAL('0 days')
RETURN date('2024-07-01')
RETURN timestamp('2024-01-05 12:34:56')
RETURN interval('1 year 2 months')
RETURN duration('1 year 2 months')
RETURN make_date(2024, 7, 1)
RETURN to_timestamp(1704456896)
