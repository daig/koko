// COERCION GAP: pass a non-declared-type arg that C++ implicitly casts. --show-all.
// --- STRING-position: numeric/bool/date -> STRING implicit cast (the documented gap) ---
RETURN left(to_double(1.34), 8)
RETURN left(123, 2)
RETURN left(true, 3)
RETURN lower(123)
RETURN upper(45.6)
RETURN reverse(123)
RETURN substr(12345, 1, 3)
RETURN contains(12345, 23)
RETURN starts_with(12345, 12)
RETURN ends_with(12345, 45)
RETURN length(12345)
RETURN size(12345)
RETURN trim(123)
RETURN lpad(12, 5, 0)
RETURN repeat(12, 3)
RETURN concat(1, 2, 3)
RETURN concat('a', 1, true)
RETURN replace(12321, 2, 9)
RETURN string_split(12345, 3)
RETURN levenshtein(123, 124)
RETURN initcap(123)
RETURN left(date('2024-01-05'), 4)
RETURN upper(date('2024-01-05'))
// --- INT-position: DOUBLE -> INT implicit cast ---
RETURN left('hello', 2.0)
RETURN left('hello', to_double(2.9))
RETURN substr('hello', 1.0, 3.0)
RETURN repeat('ab', 2.0)
RETURN lpad('x', 4.0, 'y')
// --- numeric-position: STRING -> numeric implicit cast ---
RETURN abs('-5')
RETURN sqrt('16')
RETURN sin('0')
RETURN round('1.5')
RETURN pow('2', '3')
RETURN factorial('5')
RETURN ceil('1.2')
// --- list-position / other ---
RETURN list_contains([1,2,3], '2')
RETURN list_contains(['1','2'], 2)
RETURN range('1', '3')
RETURN date_part('year', '2024-01-05')
RETURN date('2024-01-05') = '2024-01-05'
