// map functions
RETURN map(['a','b'],[1,2]) AS a
RETURN typeof(map(['a','b'],[1,2])) AS a
RETURN map_extract(map(['a','b'],[1,2]),'a') AS a
RETURN map_extract(map(['a','b'],[1,2]),'b') AS a
RETURN element_at(map(['a','b'],[1,2]),'a') AS a
RETURN map_extract(map(['a','b'],[1,2]),'c') AS a
RETURN element_at(map(['a','b'],[1,2]),'c') AS a
RETURN map_keys(map(['a','b'],[1,2])) AS a
RETURN map_values(map(['a','b'],[1,2])) AS a
RETURN cardinality(map(['a','b'],[1,2])) AS a
RETURN map([],[]) AS a
RETURN cardinality(map([],[])) AS a
RETURN map_keys(map([],[])) AS a
RETURN typeof(map([],[])) AS a
RETURN map(['a','a'],[1,2]) AS a
RETURN map_extract(map(['a','a'],[1,2]),'a') AS a
RETURN cardinality(map(['a','a'],[1,2])) AS a
RETURN map([1,2],['x','y']) AS a
RETURN map_extract(map([1,2],['x','y']),1) AS a
RETURN map(['a','b','c'],[1,2,3]) AS a
RETURN map(['a','b'],[1,2,3]) AS a
RETURN map_keys(map(['x','y','z'],[10,20,30])) AS a
RETURN map_values(map(['x','y','z'],[10,20,30])) AS a
RETURN size(map_keys(map(['a','b'],[1,2]))) AS a
