// negative integer literal boundaries
RETURN typeof(-9223372036854775807)
RETURN typeof(-9223372036854775808)
RETURN typeof(-9223372036854775809)
RETURN typeof(-2147483648)
RETURN typeof(-170141183460469231731687303715884105727)
RETURN -9223372036854775808
RETURN -9223372036854775808 + 0
// function-form cast rounding (same path?)
RETURN to_int64(1.5)
RETURN to_int64(2.5)
RETURN cast(1.5, 'INT64')
RETURN cast(2.5, 'INT64')
RETURN to_int32(3.5)
// string->number more edges
RETURN CAST('-0' AS INT64)
RETURN CAST('007' AS INT64)
RETURN CAST(' +5 ' AS INT64)
RETURN CAST('+5' AS INT32)
RETURN CAST('+5' AS UINT8)
RETURN CAST('-5.5' AS DOUBLE)
// interval extra formats
RETURN CAST('1 week' AS INTERVAL)
RETURN CAST('2 decades' AS INTERVAL)
RETURN CAST('P1Y2M3D' AS INTERVAL)
RETURN CAST('PT1H30M' AS INTERVAL)
RETURN CAST('1 year ago' AS INTERVAL)
RETURN CAST('1 millennium' AS INTERVAL)
// timestamp edges
RETURN CAST('2020-01-01 12:00:00.123456789' AS TIMESTAMP)
RETURN CAST('2020-1-1 1:2:3' AS TIMESTAMP)
RETURN CAST('2020-01-01 25:00:00' AS TIMESTAMP)
RETURN CAST('infinity' AS TIMESTAMP)
RETURN CAST('epoch' AS TIMESTAMP)
// date arithmetic + interval
RETURN date('2020-01-31') + interval('1 month')
RETURN date('2020-01-01') + 5
RETURN typeof(date('2020-01-01') + 5)
