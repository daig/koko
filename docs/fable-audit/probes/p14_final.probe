RETURN CAST(1.5 AS STRING)
RETURN CAST(100.0 AS STRING)
RETURN CAST(0.1 AS STRING)
RETURN CAST(CAST(1.5 AS FLOAT) AS STRING)
RETURN CAST(9223372036854775808 AS STRING)
RETURN CAST(true AS STRING)
RETURN CAST('05' AS INT64)
RETURN CAST('01.5' AS DOUBLE)
RETURN CAST('00' AS DOUBLE)
RETURN CAST('0' AS INT64)
RETURN CAST('-0' AS UINT8)
RETURN CAST(date('2020-01-01') AS STRING)
RETURN CAST(interval('1 year') AS STRING)
RETURN typeof(CAST(1 AS INT8) + CAST(1 AS INT8))
RETURN typeof(CAST(1 AS INT16) + CAST(1 AS INT32))
RETURN CAST('{a: 1' AS STRUCT(a INT64))
RETURN CAST('[1,2' AS INT64[])
