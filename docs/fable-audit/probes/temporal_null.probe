// NULL args to every temporal function (IS NULL disambiguates NULL vs '')
RETURN date(NULL) IS NULL
RETURN make_date(NULL, 1, 1) IS NULL
RETURN make_date(2024, NULL, 1) IS NULL
RETURN make_date(2024, 1, NULL) IS NULL
RETURN timestamp(NULL) IS NULL
RETURN to_timestamp(NULL) IS NULL
RETURN interval(NULL) IS NULL
RETURN duration(NULL) IS NULL
RETURN date_part(NULL, DATE('2024-08-15')) IS NULL
RETURN date_part('year', NULL) IS NULL
RETURN date_trunc(NULL, TIMESTAMP('2024-08-15 00:00:00')) IS NULL
RETURN date_trunc('year', NULL) IS NULL
RETURN dayname(NULL) IS NULL
RETURN monthname(NULL) IS NULL
RETURN last_day(NULL) IS NULL
RETURN century(NULL) IS NULL
RETURN to_years(NULL) IS NULL
RETURN to_months(NULL) IS NULL
RETURN to_days(NULL) IS NULL
RETURN to_hours(NULL) IS NULL
RETURN to_minutes(NULL) IS NULL
RETURN to_seconds(NULL) IS NULL
RETURN to_milliseconds(NULL) IS NULL
RETURN to_microseconds(NULL) IS NULL
RETURN greatest(DATE('2024-01-01'), NULL) IS NULL
RETURN least(NULL, DATE('2024-01-01')) IS NULL
RETURN (DATE('2024-01-05') - CAST(NULL AS DATE)) IS NULL
RETURN (DATE('2024-01-05') + CAST(NULL AS INTERVAL)) IS NULL
RETURN (CAST(NULL AS TIMESTAMP) - INTERVAL('1 hour')) IS NULL
