// Temporal arithmetic result types & values
RETURN DATE('2024-01-05') - DATE('2024-01-01')
RETURN DATE('2024-01-01') - DATE('2024-01-05')
RETURN DATE('2024-03-01') - DATE('2024-02-01')
RETURN TIMESTAMP('2024-01-05 12:34:56') - TIMESTAMP('2024-01-01 00:00:00')
RETURN TIMESTAMP('2024-01-01 12:00:00') - TIMESTAMP('2024-01-01 10:30:00')
RETURN DATE('2024-01-05') + INTERVAL('1 month')
RETURN DATE('2024-01-31') + INTERVAL('1 month')
RETURN DATE('2024-01-31') + INTERVAL('30 days')
RETURN DATE('2024-01-05') + INTERVAL('1 year')
RETURN DATE('2024-01-05') - INTERVAL('1 month')
RETURN DATE('2024-02-29') + INTERVAL('1 year')
RETURN DATE('2024-01-31') + INTERVAL('1 month 1 day')
RETURN TIMESTAMP('2024-01-05 12:34:56') + INTERVAL('1 day')
RETURN TIMESTAMP('2024-01-05 12:34:56') - INTERVAL('1 hour')
RETURN TIMESTAMP('2024-01-05 12:34:56') + INTERVAL('90 minutes')
RETURN INTERVAL('1 month') + INTERVAL('1 month')
RETURN INTERVAL('1 year 6 months') + INTERVAL('8 months')
RETURN INTERVAL('2 hours') - INTERVAL('90 minutes')
RETURN DATE('2024-01-05') + 5
RETURN DATE('2024-01-05') - 5
RETURN INTERVAL('1 day') * 3
RETURN TIMESTAMP('2024-01-31 12:00:00') + INTERVAL('1 month')
RETURN DATE('2024-12-31') + INTERVAL('1 day')
RETURN DATE('2024-03-01') - INTERVAL('1 day')
