// greatest / least — mixed types, nulls, strings
RETURN greatest(1, 2, 3)
RETURN least(1, 2, 3)
RETURN greatest(1, 2)
RETURN least(5, 3)
RETURN greatest(1.5, 2)
RETURN least(1.5, 2)
RETURN greatest(-1, -2, -3)
RETURN greatest(1, 2, null)
RETURN least(1, null, 3)
RETURN greatest(null, null)
RETURN greatest('apple', 'banana')
RETURN least('apple', 'banana')
RETURN greatest('a', 'b', 'c')
RETURN greatest(1)
RETURN greatest(3, 1, 4, 1, 5, 9, 2, 6)
RETURN greatest(1, 2.5)
RETURN least(2.5, 1)
