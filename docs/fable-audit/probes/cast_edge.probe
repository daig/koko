// round-vs-truncate interacting with range; INT128 round-trips; neg float->uint
RETURN CAST(127.9 AS INT8)
RETURN CAST(127.4 AS INT8)
RETURN CAST(-128.9 AS INT8)
RETURN CAST(255.9 AS UINT8)
RETURN CAST(-0.9 AS INT64)
RETURN CAST(0.9 AS INT64)
RETURN CAST(-0.4 AS UINT8)
RETURN CAST(0.5 AS INT64)
RETURN CAST(1.5 AS INT64)
RETURN to_string(to_int128('170141183460469231731687303715884105727'))
RETURN to_string(CAST(-170141183460469231731687303715884105728 AS INT128))
RETURN to_int128(9223372036854775807) + to_int128(1)
RETURN CAST(9007199254740993.0 AS INT64)
RETURN factorial(20)
RETURN gamma(-1)
RETURN gamma(0)
RETURN lgamma(-1)
RETURN factorial(25)
