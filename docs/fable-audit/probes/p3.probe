RETURN string({a: ['has,comma']})
RETURN string({a: ["has,comma"]})
RETURN string({a: ['plain']})
RETURN string(['toronto','montr,eal'])
RETURN string(['vanco,uver north area'])
RETURN cast('["x,y"]', 'STRING[]')
