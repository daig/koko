// ===== list equality =====
RETURN [1,2] = [1,2] AS x
RETURN [1,2] = [1,3] AS x
RETURN [1,2] = [1,2,3] AS x
RETURN [1,2,3] = [1,2] AS x
RETURN [] = [] AS x
RETURN [1] = [] AS x
RETURN [1,2] <> [1,3] AS x
RETURN [1,2] <> [1,2] AS x
RETURN ['a','b'] = ['a','b'] AS x
RETURN [1.0,2.0] = [1,2] AS x
RETURN [1] = [1.0] AS x
// ===== list lexicographic ordering =====
RETURN [1,2] < [1,3] AS x
RETURN [1,3] < [1,2] AS x
RETURN [1,2] < [2] AS x
RETURN [2] < [1,2] AS x
RETURN [1] < [1,2] AS x
RETURN [1,2] < [1] AS x
RETURN [1,2] <= [1,2] AS x
RETURN [1,2] >= [1,2] AS x
RETURN [1,2] > [1,1] AS x
RETURN [1,2,3] < [1,2,4] AS x
RETURN ['a','b'] < ['a','c'] AS x
RETURN ['abc'] < ['abd'] AS x
RETURN [1] < [1,2,3] AS x
RETURN [] < [1] AS x
RETURN [] < [] AS x
// ===== nested lists =====
RETURN [[1],[2]] = [[1],[2]] AS x
RETURN [[1],[2]] = [[1],[3]] AS x
RETURN [[1,2],[3]] < [[1,3],[3]] AS x
RETURN [[1]] < [[1],[2]] AS x
// ===== NULL-containing lists =====
RETURN [1,NULL] = [1,NULL] AS x
RETURN [NULL] = [NULL] AS x
RETURN [1,NULL] = [1,2] AS x
RETURN [NULL,2] = [1,2] AS x
RETURN [1,NULL] < [1,2] AS x
RETURN [1,NULL] <> [1,2] AS x
RETURN [NULL] = [] AS x
RETURN typeof([1,NULL] = [1,NULL]) AS x
RETURN typeof([1,NULL] = [1,2]) AS x
// ===== struct equality =====
RETURN {a:1} = {a:1} AS x
RETURN {a:1} = {a:2} AS x
RETURN {a:1,b:2} = {a:1,b:2} AS x
RETURN {a:1,b:2} = {b:2,a:1} AS x
RETURN {a:1,b:2} <> {a:1,b:3} AS x
RETURN {a:1} = {a:1,b:2} AS x
RETURN {a:'x'} = {a:'x'} AS x
RETURN {a:NULL} = {a:NULL} AS x
RETURN {a:NULL} = {a:1} AS x
RETURN {a:1,b:NULL} = {a:1,b:NULL} AS x
RETURN {a:{b:1}} = {a:{b:1}} AS x
RETURN {a:{b:1}} = {a:{b:2}} AS x
// ===== struct ordering =====
RETURN {a:1} < {a:2} AS x
RETURN {a:1,b:2} < {a:1,b:3} AS x
// ===== map (via map function) =====
RETURN map([1,2],['a','b']) = map([1,2],['a','b']) AS x
RETURN map(['a'],[1]) = map(['a'],[2]) AS x
RETURN map(['a'],[1]) = map(['a'],[1]) AS x
// ===== cross-type equality =====
RETURN 1 = '1' AS x
RETURN 1 = true AS x
RETURN true = 1 AS x
RETURN 'a' = 97 AS x
RETURN [1] = 1 AS x
RETURN {a:1} = [1] AS x
RETURN 1 = 1.0 AS x
RETURN 1.5 = 1 AS x
// ===== typeof composite comparisons =====
RETURN typeof([1,2] = [1,2]) AS x
RETURN typeof({a:1} = {a:1}) AS x
