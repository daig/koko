// date_part every keyword on a TIMESTAMP (2024-08-15 13:45:30.123456)
RETURN date_part('year', TIMESTAMP('2024-08-15 13:45:30.123456'))
RETURN date_part('month', TIMESTAMP('2024-08-15 13:45:30.123456'))
RETURN date_part('day', TIMESTAMP('2024-08-15 13:45:30.123456'))
RETURN date_part('hour', TIMESTAMP('2024-08-15 13:45:30.123456'))
RETURN date_part('minute', TIMESTAMP('2024-08-15 13:45:30.123456'))
RETURN date_part('second', TIMESTAMP('2024-08-15 13:45:30.123456'))
RETURN date_part('millisecond', TIMESTAMP('2024-08-15 13:45:30.123456'))
RETURN date_part('microsecond', TIMESTAMP('2024-08-15 13:45:30.123456'))
RETURN date_part('decade', TIMESTAMP('2024-08-15 13:45:30.123456'))
RETURN date_part('century', TIMESTAMP('2024-08-15 13:45:30.123456'))
RETURN date_part('millennium', TIMESTAMP('2024-08-15 13:45:30.123456'))
RETURN date_part('quarter', TIMESTAMP('2024-08-15 13:45:30.123456'))
RETURN date_part('week', TIMESTAMP('2024-08-15 13:45:30.123456'))
RETURN date_part('weekofyear', TIMESTAMP('2024-08-15 13:45:30.123456'))
RETURN date_part('dow', TIMESTAMP('2024-08-15 13:45:30.123456'))
RETURN date_part('isodow', TIMESTAMP('2024-08-15 13:45:30.123456'))
RETURN date_part('doy', TIMESTAMP('2024-08-15 13:45:30.123456'))
RETURN date_part('epoch', TIMESTAMP('2024-08-15 13:45:30.123456'))
RETURN date_part('isoyear', TIMESTAMP('2024-08-15 13:45:30.123456'))
// second should include fractional? check millisecond/microsecond semantics
RETURN date_part('second', TIMESTAMP('2024-08-15 13:45:30'))
RETURN date_part('millisecond', TIMESTAMP('2024-08-15 13:45:30.5'))
RETURN date_part('microsecond', TIMESTAMP('2024-08-15 13:45:30.5'))
