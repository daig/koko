// make_date valid + invalid
RETURN make_date(2024, 7, 1)
RETURN make_date(2024, 12, 31)
RETURN make_date(2024, 2, 29)
RETURN make_date(2023, 2, 29)
RETURN make_date(2024, 2, 30)
RETURN make_date(2024, 13, 1)
RETURN make_date(2024, 0, 1)
RETURN make_date(2024, 1, 0)
RETURN make_date(2024, 1, 32)
RETURN make_date(2024, -1, 1)
RETURN make_date(0, 1, 1)
// to_timestamp seconds
RETURN to_timestamp(0)
RETURN to_timestamp(1704456896)
RETURN to_timestamp(1704456896.5)
RETURN to_timestamp(-1)
RETURN to_timestamp(-1704456896)
RETURN to_timestamp(1.5)
// date() parse edge cases
RETURN date('2024-13-01')
RETURN date('2024-02-30')
RETURN date('2024-00-01')
RETURN date('not a date')
RETURN date('2024/07/01')
RETURN date('2024-07')
// timestamp() parse edge cases
RETURN timestamp('2024-01-05 25:00:00')
RETURN timestamp('2024-01-05 12:60:00')
RETURN timestamp('not a ts')
RETURN timestamp('2024-13-01 00:00:00')
// interval() / duration() parse edge cases
RETURN interval('garbage')
RETURN interval('')
RETURN duration('1 year')
