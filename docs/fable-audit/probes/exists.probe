// Existence probes for suspected-missing functions. --show-all to see both outputs.
RETURN concat_ws('-', 'a', 'b', 'c')
RETURN count_if(true)
RETURN current_date()
RETURN current_timestamp() IS NOT NULL
RETURN octet_length(BLOB('abc'))
RETURN encode('abc')
RETURN decode(encode('abc'))
RETURN epoch_ms(1000)
RETURN to_epoch_ms(TIMESTAMP('1970-01-01 00:00:01'))
RETURN hash(1)
RETURN md5('abc')
RETURN sha256('abc')
RETURN internal_id(0, 0)
RETURN random() >= 0.0
RETURN setseed(0.5)
RETURN struct_pack(a := 1, b := 2)
RETURN to_interval('1 day')
RETURN list_has([1,2,3], 2)
RETURN list_has_all([1,2,3], [1,2])
RETURN array_has([1,2,3], 2)
RETURN array_append([1,2], 3)
RETURN array_prepend(0, [1,2])
RETURN array_push_back([1,2], 3)
RETURN array_push_front(0, [1,2])
RETURN tolower('ABC')
RETURN toupper('abc')
RETURN to_years(2)
RETURN error('boom')
RETURN any(x IN [1,2,3] WHERE x > 2)
RETURN all(x IN [1,2,3] WHERE x > 0)
RETURN none(x IN [1,2,3] WHERE x > 5)
RETURN single(x IN [1,2,3] WHERE x = 2)
RETURN list_transform([1,2,3], x -> x + 1)
RETURN list_filter([1,2,3], x -> x > 1)
RETURN list_reduce([1,2,3], (x, y) -> x + y)
RETURN cast(1 AS DOUBLE)
RETURN CAST(1 AS STRING)
