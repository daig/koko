// ===== integer overflow / underflow =====
RETURN 9223372036854775807 + 1 AS x
RETURN 9223372036854775807 + 2 AS x
RETURN 9223372036854775806 + 1 AS x
RETURN -9223372036854775808 - 1 AS x
RETURN -9223372036854775808 - 2 AS x
RETURN -9223372036854775807 - 1 AS x
RETURN -9223372036854775807 - 2 AS x
RETURN 9223372036854775807 * 2 AS x
RETURN 4611686018427387904 * 2 AS x
RETURN -9223372036854775808 * -1 AS x
RETURN 9223372036854775807 * -1 AS x
RETURN -9223372036854775808 / -1 AS x
RETURN 0 - 9223372036854775807 AS x
RETURN 0 - (-9223372036854775808) AS x
RETURN -(-9223372036854775808) AS x
RETURN 9223372036854775807 % -1 AS x
RETURN -9223372036854775808 % -1 AS x
RETURN 9223372036854775807 + 0 AS x
RETURN 3037000499 * 3037000499 AS x
RETURN 3037000500 * 3037000500 AS x
// ===== string concat coercion breadth (cpp rejects STRING+non-STRING) =====
RETURN 1.5 + 'a' AS x
RETURN 'a' + 1.5 AS x
RETURN 'a' + [1,2] AS x
RETURN [1,2] + 'a' AS x
RETURN 'a' + {b:1} AS x
RETURN {b:1} + 'a' AS x
RETURN 'a' + date('2020-01-01') AS x
RETURN date('2020-01-01') + 'a' AS x
RETURN 'a' + 2 + 3 AS x
RETURN 1 + 2 + 'a' AS x
RETURN 'n=' + (1 + 2) AS x
RETURN 'a' + true + 'b' AS x
RETURN 'a' + 1 = 'a1' AS x
RETURN typeof('a' + 1) AS x
RETURN typeof(1 + 'a') AS x
RETURN size('a' + 123) AS x
// ===== numeric type widening in arithmetic =====
RETURN typeof(1 + 1) AS x
RETURN typeof(1 + 1.0) AS x
RETURN typeof(1.0 + 1.0) AS x
RETURN typeof(2147483647 + 1) AS x
RETURN 127 + 1 AS x
RETURN CAST(127 AS INT8) + CAST(1 AS INT8) AS x
RETURN CAST(127 AS INT8) + CAST(100 AS INT8) AS x
