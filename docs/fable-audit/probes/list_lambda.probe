// lambda: transform / filter / reduce
#ORDER# RETURN list_transform([1,2,3], x -> x+1) AS a
#ORDER# RETURN list_transform([1,2,3], x -> x*x) AS a
#ORDER# RETURN list_filter([1,2,3,4], x -> x>2) AS a
#ORDER# RETURN list_filter([1,2,3,4], x -> x%2=0) AS a
RETURN list_reduce([1,2,3,4], (a,b) -> a+b) AS a
RETURN list_reduce([1,2,3,4], (a,b) -> a*b) AS a
#ORDER# RETURN list_transform([], x -> x+1) AS a
#ORDER# RETURN list_filter([], x -> x>2) AS a
RETURN list_reduce([5], (a,b) -> a+b) AS a
#ORDER# RETURN list_transform(['a','b'], x -> x) AS a
#ORDER# RETURN list_filter([1,null,3], x -> x>1) AS a
#ORDER# RETURN list_transform([1,2,3], x -> x > 1) AS a
RETURN list_reduce([], (a,b) -> a+b) AS a
#ORDER# RETURN list_transform([1,2,3], x -> list_sum([x,x])) AS a
