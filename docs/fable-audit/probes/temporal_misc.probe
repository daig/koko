// last_day: leap Feb, non-leap Feb, Dec, and 30-day month
RETURN last_day(DATE('2024-02-10'))
RETURN last_day(DATE('2023-02-10'))
RETURN last_day(DATE('2024-12-05'))
RETURN last_day(DATE('2024-04-15'))
RETURN last_day(DATE('2024-01-31'))
RETURN last_day(TIMESTAMP('2024-02-10 13:00:00'))
// century boundaries
RETURN century(DATE('2000-01-01'))
RETURN century(DATE('2001-01-01'))
RETURN century(DATE('1900-12-31'))
RETURN century(DATE('1901-01-01'))
RETURN century(TIMESTAMP('2000-06-15 00:00:00'))
// dayname / monthname
RETURN dayname(DATE('2024-07-01'))
RETURN dayname(DATE('2024-08-15'))
RETURN dayname(TIMESTAMP('2024-07-01 12:00:00'))
RETURN monthname(DATE('2024-07-01'))
RETURN monthname(DATE('2024-12-25'))
RETURN monthname(TIMESTAMP('2024-01-15 00:00:00'))
// greatest / least on temporals
RETURN greatest(DATE('2024-01-01'), DATE('2024-12-31'))
RETURN least(DATE('2024-01-01'), DATE('2024-12-31'))
RETURN greatest(TIMESTAMP('2024-01-01 00:00:00'), TIMESTAMP('2024-01-01 12:00:00'))
RETURN least(INTERVAL('1 year'), INTERVAL('6 months'))
RETURN greatest(INTERVAL('1 year'), INTERVAL('18 months'))
// date_part convenience wrappers
RETURN dayofweek(DATE('2024-08-15'))
RETURN dayofmonth(DATE('2024-08-15'))
// to_timestamp / date conversions
RETURN date(TIMESTAMP('2024-08-15 13:45:30'))
RETURN CAST(TIMESTAMP('2024-08-15 13:45:30') AS DATE)
