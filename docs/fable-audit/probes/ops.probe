// ===== Basic arithmetic =====
RETURN 1 + 2 AS x
RETURN 1 - 2 AS x
RETURN 2 * 3 AS x
RETURN 7 / 2 AS x
RETURN 7 % 2 AS x
RETURN 8 / 4 AS x
RETURN 8 % 4 AS x
RETURN 0 - 5 AS x
RETURN 5 - 8 AS x
RETURN 100 * 100 AS x
// ===== integer vs float division =====
RETURN 7.0 / 2 AS x
RETURN 7 / 2.0 AS x
RETURN 7.0 / 2.0 AS x
RETURN 5 / 2 AS x
RETURN 5.0 / 2.0 AS x
RETURN 1 / 3 AS x
RETURN 1.0 / 3 AS x
RETURN 10 / 3 AS x
RETURN 10.0 / 3.0 AS x
RETURN 6 / 4 AS x
RETURN 6.0 / 4 AS x
// ===== negative division (truncation direction) =====
RETURN -7 / 2 AS x
RETURN 7 / -2 AS x
RETURN -7 / -2 AS x
RETURN -1 / 3 AS x
RETURN -10 / 3 AS x
RETURN 10 / -3 AS x
RETURN -6 / 4 AS x
RETURN -7.0 / 2 AS x
RETURN 7.0 / -2 AS x
// ===== modulo, negative operands =====
RETURN 7 % 3 AS x
RETURN -7 % 3 AS x
RETURN 7 % -3 AS x
RETURN -7 % -3 AS x
RETURN -1 % 3 AS x
RETURN 1 % -3 AS x
RETURN 10 % 3 AS x
RETURN -10 % 3 AS x
RETURN 10 % -3 AS x
RETURN -10 % -3 AS x
RETURN 0 % 5 AS x
RETURN 5 % 5 AS x
// ===== float modulo =====
RETURN 7.5 % 2 AS x
RETURN 7.5 % 2.5 AS x
RETURN -7.5 % 2 AS x
RETURN 7.5 % -2 AS x
RETURN 5.5 % 2.0 AS x
RETURN 10.0 % 3.0 AS x
RETURN -10.5 % 3 AS x
// ===== power ^ (known missing in Rust) =====
RETURN 2 ^ 3 AS x
RETURN 2 ^ 0 AS x
RETURN 2 ^ 0.5 AS x
RETURN 2 ^ -1 AS x
RETURN 4 ^ 0.5 AS x
RETURN 2 ^ 10 AS x
RETURN 9 ^ 0.5 AS x
RETURN 2.0 ^ 3.0 AS x
RETURN 0 ^ 0 AS x
RETURN -2 ^ 2 AS x
RETURN 2 ^ 3 ^ 2 AS x
RETURN (2 ^ 3) ^ 2 AS x
RETURN 2 ^ (3 ^ 2) AS x
// ===== unary minus =====
RETURN -5 AS x
RETURN --5 AS x
RETURN -(-5) AS x
RETURN - 5 AS x
RETURN -5.5 AS x
RETURN -(2 + 3) AS x
RETURN -2 + 3 AS x
RETURN 3 + -2 AS x
RETURN 3 - -2 AS x
RETURN 3 * -2 AS x
RETURN -0 AS x
RETURN -0.0 AS x
// ===== precedence =====
RETURN 2 + 3 * 4 AS x
RETURN (2 + 3) * 4 AS x
RETURN 2 * 3 + 4 AS x
RETURN 2 + 3 * 4 - 1 AS x
RETURN 10 - 2 - 3 AS x
RETURN 100 / 10 / 2 AS x
RETURN 2 * 3 % 4 AS x
RETURN 10 % 4 * 2 AS x
RETURN 10 + 6 % 4 AS x
RETURN 5 / 2 * 2 AS x
RETURN 20 / 4 % 3 AS x
RETURN 1 + 2 * 3 - 4 / 2 AS x
RETURN 2 * (3 + 4) * 5 AS x
RETURN ((1 + 2) * (3 + 4)) AS x
// ===== string concat =====
RETURN 'a' + 'b' AS x
RETURN 'a' + 'b' + 'c' AS x
RETURN 'hello ' + 'world' AS x
RETURN '' + 'x' AS x
RETURN 'x' + '' AS x
RETURN 'a' + 1 AS x
RETURN 1 + 'a' AS x
RETURN 'a' + 1.5 AS x
RETURN 'val=' + 42 AS x
RETURN 'a' + true AS x
RETURN true + 'a' AS x
RETURN 'a' + NULL AS x
// ===== list concat =====
RETURN [1,2] + [3,4] AS x
RETURN [1,2,3] + [] AS x
RETURN [] + [1] AS x
RETURN [1] + 2 AS x
RETURN 1 + [2] AS x
RETURN ['a'] + ['b'] AS x
RETURN [1,2] + [3.5] AS x
RETURN [[1],[2]] + [[3]] AS x
RETURN [1] + NULL AS x
RETURN [1,2] + 3 + 4 AS x
// ===== division by zero =====
RETURN 1 / 0 AS x
RETURN 1 % 0 AS x
RETURN 0 / 0 AS x
RETURN 1.0 / 0.0 AS x
RETURN 1.0 / 0 AS x
RETURN 0.0 / 0.0 AS x
RETURN 1.5 % 0 AS x
RETURN 1.5 % 0.0 AS x
RETURN -1 / 0 AS x
// ===== overflow =====
RETURN 9223372036854775807 + 1 AS x
RETURN 9223372036854775807 * 2 AS x
RETURN -9223372036854775808 - 1 AS x
RETURN 9223372036854775807 AS x
RETURN 9223372036854775808 AS x
// ===== mixed coercion =====
RETURN 1 + 2.0 AS x
RETURN 1.0 + 2 AS x
RETURN 3 * 2.5 AS x
RETURN 2.5 * 3 AS x
RETURN true + 1 AS x
RETURN 1 + true AS x
// ===== unary minus on properties (needs data) =====
RETURN typeof(1 + 2) AS x
RETURN typeof(7 / 2) AS x
RETURN typeof(7.0 / 2) AS x
RETURN typeof(7 % 2) AS x
RETURN typeof(2 ^ 3) AS x
RETURN typeof(-5) AS x
RETURN typeof('a' + 'b') AS x
RETURN typeof([1] + [2]) AS x
