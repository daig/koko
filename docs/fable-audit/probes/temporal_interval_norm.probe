// INTERVAL constructors from integers + normalization/rendering
RETURN to_years(2)
RETURN to_months(13)
RETURN to_months(1)
RETURN to_months(25)
RETURN to_days(40)
RETURN to_days(1)
RETURN to_hours(25)
RETURN to_hours(1)
RETURN to_minutes(90)
RETURN to_minutes(1)
RETURN to_seconds(90)
RETURN to_seconds(3661)
RETURN to_seconds(1)
RETURN to_milliseconds(1500)
RETURN to_milliseconds(1)
RETURN to_microseconds(1500000)
RETURN to_microseconds(1)
// negatives
RETURN to_months(-13)
RETURN to_seconds(-90)
RETURN to_days(-40)
RETURN to_hours(-25)
// zero
RETURN to_months(0)
RETURN to_seconds(0)
// INTERVAL string parse normalization
RETURN INTERVAL('13 months')
RETURN INTERVAL('90 minutes')
RETURN INTERVAL('3661 seconds')
RETURN INTERVAL('36 hours')
RETURN INTERVAL('40 days')
RETURN INTERVAL('1500 milliseconds')
RETURN INTERVAL('2 years 15 months')
RETURN INTERVAL('90 minutes 90 seconds')
// combined via to_ functions rendering
RETURN to_microseconds(90000000)
RETURN to_milliseconds(90500)
