// round / floor / ceil / ceiling — half-even vs half-away, negatives
RETURN round(0.5)
RETURN round(1.5)
RETURN round(2.5)
RETURN round(-0.5)
RETURN round(-1.5)
RETURN round(-2.5)
RETURN round(2.675, 2)
RETURN round(2.4)
RETURN round(2.6)
RETURN round(3.14159, 2)
RETURN round(3.14159, 0)
RETURN round(-3.14159, 2)
RETURN round(1234.5678, -2)
RETURN round(123, 0)
RETURN floor(2.5)
RETURN floor(-2.5)
RETURN floor(-2.1)
RETURN floor(2.9)
RETURN floor(3)
RETURN floor(-0.0)
RETURN ceil(2.1)
RETURN ceil(-2.1)
RETURN ceil(-2.9)
RETURN ceil(3)
RETURN ceiling(2.1)
RETURN ceiling(-2.9)
RETURN round(null)
RETURN floor(null)
RETURN ceil(null)
RETURN round(1.23456, null)
