// date_part every keyword on a DATE (2024-08-15 is a Thursday; ISO week 33; doy 228)
RETURN date_part('year', DATE('2024-08-15'))
RETURN date_part('month', DATE('2024-08-15'))
RETURN date_part('day', DATE('2024-08-15'))
RETURN date_part('hour', DATE('2024-08-15'))
RETURN date_part('minute', DATE('2024-08-15'))
RETURN date_part('second', DATE('2024-08-15'))
RETURN date_part('millisecond', DATE('2024-08-15'))
RETURN date_part('microsecond', DATE('2024-08-15'))
RETURN date_part('decade', DATE('2024-08-15'))
RETURN date_part('century', DATE('2024-08-15'))
RETURN date_part('millennium', DATE('2024-08-15'))
RETURN date_part('quarter', DATE('2024-08-15'))
RETURN date_part('week', DATE('2024-08-15'))
RETURN date_part('weekofyear', DATE('2024-08-15'))
RETURN date_part('dayofweek', DATE('2024-08-15'))
RETURN date_part('weekday', DATE('2024-08-15'))
RETURN date_part('dow', DATE('2024-08-15'))
RETURN date_part('isodow', DATE('2024-08-15'))
RETURN date_part('doy', DATE('2024-08-15'))
RETURN date_part('dayofyear', DATE('2024-08-15'))
RETURN date_part('epoch', DATE('2024-08-15'))
RETURN date_part('isoyear', DATE('2024-08-15'))
// week edge cases (Rust hardcodes week=>0) — confirm vs C++
RETURN date_part('week', DATE('2024-01-15'))
RETURN date_part('week', DATE('2024-12-31'))
RETURN date_part('doy', DATE('2024-12-31'))
// alias datepart + plural forms
RETURN datepart('year', DATE('2024-08-15'))
RETURN date_part('years', DATE('2024-08-15'))
RETURN date_part('days', DATE('2024-08-15'))
RETURN date_part('MONTH', DATE('2024-08-15'))
